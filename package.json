{
  "name": "html-docs-to-learn",
  "private": true,
  "type": "module",
  "description": "An Astro site that routes to local HTML pages and imported external HTML pages, deployed to GitHub Pages.",
  "scripts": {
    "prepare:pages": "node tools/prepare.mjs",
    "dev": "node tools/prepare.mjs && astro dev",
    "start": "npm run dev",
    "build": "node tools/prepare.mjs && astro build",
    "build:refresh": "node tools/prepare.mjs --refresh && astro build",
    "preview": "astro preview",
    "import": "node tools/import.mjs",
    "add": "node tools/add.mjs",
    "check": "astro check",
    "whichnode": "node -e \"console.log(process.version + ' | ' + process.execPath)\"",
    "shots": "node tools/shots.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/sitemap": "^3.7.3",
    "@supabase/supabase-js": "^2.112.3",
    "@types/turndown": "^5.0.6",
    "astro": "^7.2.4",
    "gsap": "^3.15.0",
    "quill": "^2.0.2",
    "three": "^0.185.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/three": "^0.185.4"
  }
}
