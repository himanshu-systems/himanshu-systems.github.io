---
import { loadRegistry } from '../../tools/registry.mjs';
import Doc from '../layouts/Doc.astro';
import { home, collection } from '../lib/paths';

const { site } = await loadRegistry();
---

<Doc title="Not found" siteTitle={site.title} chrome={false}>
  <p class="code">404</p>
  <h1>No page on that route</h1>
  <p class="lede">This route is not registered in <code>pages.json</code>.</p>
  <p><a href={collection}>See every page</a> &middot; <a href={home}>about</a></p>
</Doc>

<style>
  .code {
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .16em;
    color: var(--faint);
    margin: 0 0 1.5rem;
  }

  .lede {
    color: var(--muted);
  }
</style>
