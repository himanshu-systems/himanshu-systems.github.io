---
import Doc from '../layouts/Doc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { loadRegistry } from '../../tools/registry.mjs';
import { home, collection, routeHref } from '../lib/paths';

const { site } = await loadRegistry();
---

<Doc title="Admin" siteTitle={site.title} chrome={false} noindex wide floatingShape={false} smoothScroll={false} instrument={false} prose={false}>
  <header>
    <div class="masthead">
      <p class="eyebrow">Admin</p>
      <nav>
        <a href={home}>About</a>
        <a href={collection}>Pages</a>
        <a href={routeHref('/tried')}>Tried</a>
        <a href={routeHref('/blog')}>Blog</a>
        <ThemeToggle />
      </nav>
    </div>
    <h1>Manage the site</h1>
  </header>

  <section id="login-section" class="panel">
    <p class="standfirst">
      Everything on the about page and the Tried log is editable here. This
      page isn't linked from anywhere else, but that isn't what keeps it
      yours &mdash; logging in is.
    </p>
    <form id="login-form">
      <label>
        <span>Email</span>
        <input type="email" id="login-email" autocomplete="username" required />
      </label>
      <label>
        <span>Password</span>
        <input type="password" id="login-password" autocomplete="current-password" required />
      </label>
      <button type="submit" class="primary">Log in</button>
      <button type="button" id="forgot" class="linkish">Forgot password?</button>
      <p class="notice error" id="login-error" hidden></p>
      <p class="notice" id="login-notice" hidden></p>
    </form>
  </section>

  <!-- Shown only when Supabase reports a PASSWORD_RECOVERY session, i.e. you
       arrived from a reset link. The link must point at THIS page: the site
       root has no client-side Supabase (its content is read at build time), so
       a recovery token delivered there is never consumed by anything. -->
  <section id="recovery-section" class="panel" hidden>
    <p class="standfirst">
      You followed a password reset link. Set a new password to finish.
    </p>
    <form id="recovery-form">
      <label>
        <span>New password</span>
        <input type="password" id="recovery-password" autocomplete="new-password" minlength="8" required />
      </label>
      <button type="submit" class="primary">Set password</button>
      <p class="notice error" id="recovery-error" hidden></p>
    </form>
  </section>

  <section id="admin-section" hidden>
    <div class="admin-bar">
      <span id="who"></span>
      <button type="button" id="logout">Log out</button>
    </div>

    <div class="tabs" role="tablist">
      <button type="button" class="tab" id="tab-about" data-tab="about" aria-selected="true">About page</button>
      <button type="button" class="tab" id="tab-tried" data-tab="tried" aria-selected="false">Tried entries</button>
      <button type="button" class="tab" id="tab-blog" data-tab="blog" aria-selected="false">Blog</button>
    </div>

    <!-- ───────────────────────── About page ───────────────────────── -->
    <div id="panel-about" class="tab-panel">
      <form id="about-form">
        <section class="panel">
          <h2>Profile</h2>

          <label>
            <span>Name</span>
            <input type="text" id="a-name" required />
          </label>

          <label>
            <span>Role <small>the big line under your name</small></span>
            <input type="text" id="a-role" required />
          </label>

          <label>
            <span>Intro</span>
            <div id="a-intro-editor" class="rich-editor"></div>
          </label>

          <label>
            <span>Now <small>optional — clear it to hide the line entirely</small></span>
            <input type="text" id="a-now" />
          </label>

          <div class="row-fields">
            <label class="field-narrow">
              <span>Portrait path <small>in static/images/, or upload below</small></span>
              <input type="text" id="a-portrait-src" placeholder="images/portrait.jpg" />
            </label>
            <label class="field-narrow">
              <span>Portrait alt text</span>
              <input type="text" id="a-portrait-alt" />
            </label>
            <label class="field-narrow upload-field">
              <span>Upload a photo</span>
              <input type="file" id="a-portrait-upload" accept="image/*" />
              <span class="upload-status" id="a-portrait-upload-status" hidden></span>
            </label>
          </div>
        </section>

        <details class="panel collapsible" id="section-doing">
          <summary>
            <span class="chev" aria-hidden="true">▸</span>
            <span>What I do</span>
            <span class="count" id="count-doing">0</span>
          </summary>
          <div class="panel-body">
            <div id="doing-list" class="list"></div>
            <button type="button" class="add-row" id="add-doing">+ Add row</button>
          </div>
        </details>

        <details class="panel collapsible" id="section-work">
          <summary>
            <span class="chev" aria-hidden="true">▸</span>
            <span>Selected work</span>
            <span class="count" id="count-work">0</span>
          </summary>
          <div class="panel-body">
            <p class="notice">
              The homepage no longer reads this. Selected work now comes from
              <code>content/selected-work.json</code> in the repo &mdash; edit
              that and rebuild, or run <code>npm run seed:work</code> to push
              the file here too. This editor still writes
              <code>site_content.work</code>, which nothing renders today.
            </p>
            <div id="work-list" class="list"></div>
            <button type="button" class="add-row" id="add-work">+ Add row</button>
          </div>
        </details>

        <details class="panel collapsible" id="section-gallery">
          <summary>
            <span class="chev" aria-hidden="true">▸</span>
            <span>Images</span>
            <span class="count" id="count-gallery">0</span>
          </summary>
          <div class="panel-body">
            <div id="gallery-list" class="list"></div>
            <button type="button" class="add-row" id="add-gallery">+ Add row</button>
          </div>
        </details>

        <details class="panel collapsible" id="section-elsewhere">
          <summary>
            <span class="chev" aria-hidden="true">▸</span>
            <span>Elsewhere</span>
            <span class="count" id="count-elsewhere">0</span>
          </summary>
          <div class="panel-body">
            <div id="elsewhere-list" class="list"></div>
            <button type="button" class="add-row" id="add-elsewhere">+ Add row</button>
          </div>
        </details>

        <div class="actions">
          <button type="submit" class="primary">Save about page</button>
          <p class="notice" id="about-status" hidden></p>
        </div>
      </form>
    </div>

    <!-- ───────────────────────── Tried entries ───────────────────────── -->
    <div id="panel-tried" class="tab-panel" hidden>
      <div class="list-toolbar">
        <button type="button" class="primary" id="new-entry-button">+ New entry</button>
        <span class="notice" id="form-status" hidden></span>
      </div>

      <div id="entry-form-wrapper" class="panel" hidden>
        <div class="panel-head">
          <p class="form-title" id="form-title">New entry</p>
          <button type="button" id="cancel-edit">Close</button>
        </div>

        <form id="entry-form">
          <div class="row-fields">
            <label class="field-narrow">
              <span>Date</span>
              <input type="date" id="f-date" required />
            </label>
            <label class="checkbox field-narrow">
              <input type="checkbox" id="f-public" />
              <span>Public — visible on the live site</span>
            </label>
          </div>

          <label>
            <span>Title</span>
            <input type="text" id="f-title" required />
          </label>

          <label>
            <span>Note <small>shows in every list and teaser</small></span>
            <textarea id="f-note" rows="2" required></textarea>
          </label>

          <label>
            <span>Description <small>optional — shows on the entry's own page only</small></span>
            <div id="f-description-editor" class="rich-editor"></div>
          </label>

          <div class="row-fields">
            <label class="field-narrow">
              <span>Outcome</span>
              <input type="text" id="f-outcome" placeholder="worked, failed, mixed, ongoing…" required />
            </label>
            <label class="field-narrow">
              <span>Liked</span>
              <input type="text" id="f-liked" placeholder="liked it, not for me…" required />
            </label>
            <label class="field-narrow">
              <span>Tags <small>comma separated</small></span>
              <input type="text" id="f-tags" placeholder="systems, security" />
            </label>
          </div>

          <div class="row-fields">
            <label class="field-narrow">
              <span>Image path <small>in static/images/, or upload below</small></span>
              <input type="text" id="f-image-src" placeholder="images/whatever.jpg" />
            </label>
            <label class="field-narrow">
              <span>Image alt text</span>
              <input type="text" id="f-image-alt" />
            </label>
            <label class="field-narrow upload-field">
              <span>Upload a photo</span>
              <input type="file" id="f-image-upload" accept="image/*" />
              <span class="upload-status" id="f-image-upload-status" hidden></span>
            </label>
          </div>

          <p class="notice" id="f-slug-note" hidden></p>

          <div class="actions">
            <button type="submit" class="primary" id="save-button">Save</button>
          </div>
        </form>
      </div>

      <table class="entries-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Entry</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="entry-list"></tbody>
      </table>
      <p class="empty" id="list-empty" hidden>No entries yet.</p>
    </div>

    <!-- ───────────────────────── Blog posts ───────────────────────── -->
    <div id="panel-blog" class="tab-panel" role="tabpanel" hidden>
      <div class="list-toolbar bar">
        <button type="button" class="primary" id="btn-new-post">+ New post</button>
        <span class="count-badge" id="b-posts-count-wrap">
          <span id="b-posts-count">0</span> posts
        </span>
        <span class="notice" id="b-status" hidden></span>
      </div>

      <!-- Modal dialog for create / edit post -->
      <div id="b-modal" class="modal-backdrop" hidden>
        <div class="modal-dialog panel">
          <div class="panel-head">
            <h2 class="form-title" id="b-modal-title">New post</h2>
            <button type="button" id="b-cancel">Close</button>
          </div>

          <form id="b-form">
            <input type="hidden" id="b-id" />

            <div class="row-fields">
              <label class="field-narrow">
                <span>Date</span>
                <input type="date" id="b-date" required />
              </label>
              <label class="checkbox field-narrow">
                <input type="checkbox" id="b-published" />
                <span>Public — visible on the live site</span>
              </label>
            </div>

            <label>
              <span>Title</span>
              <input type="text" id="b-title" placeholder="Post title" required />
            </label>

            <label>
              <span>Slug <small>URL path /blog/[slug]/ — auto-generated from title</small></span>
              <input type="text" id="b-slug" placeholder="post-slug" required />
            </label>

            <label>
              <span>Description <small>summary shown in blog index and meta tags</small></span>
              <textarea id="b-desc" rows="2" placeholder="Brief summary of the article"></textarea>
            </label>

            <label>
              <span>Content <small>rich text article body</small></span>
              <div id="b-content-editor" class="rich-editor"></div>
            </label>

            <div class="row-fields">
              <label class="field-narrow">
                <span>Tags <small>comma separated</small></span>
                <input type="text" id="b-tags" placeholder="systems, rust, web" />
              </label>
              <label class="field-narrow">
                <span>Reading time <small>e.g. 4 min read</small></span>
                <input type="text" id="b-reading-time" placeholder="4 min read" />
              </label>
            </div>

            <div class="row-fields">
              <label class="field-narrow">
                <span>Cover image path <small>in static/images/, or upload below</small></span>
                <input type="text" id="b-image-src" placeholder="images/cover.jpg" />
              </label>
              <label class="field-narrow">
                <span>Cover image alt text</span>
                <input type="text" id="b-image-alt" placeholder="Descriptive alt text" />
              </label>
              <label class="field-narrow upload-field">
                <span>Upload cover image</span>
                <input type="file" id="b-image-file" accept="image/*" />
                <span class="upload-status" id="b-image-status" hidden></span>
              </label>
            </div>

            <div class="actions">
              <button type="submit" class="primary" id="b-save">Save post</button>
              <button type="button" id="b-cancel-btn">Cancel</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Table body: id="b-tbody" / id="b-posts-body", New button: id="b-new" / id="btn-new-post" -->
      <table class="entries-table" id="b-posts-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Post</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="b-posts-body"></tbody>
      </table>
      <p class="empty" id="b-empty" hidden>No blog posts yet.</p>
    </div>
  </section>
</Doc>

<script>
  import { initTabs } from '../lib/admin/tabs';
  import { initAboutEditor } from '../lib/admin/aboutEditor';
  import { initTriedEditor } from '../lib/admin/triedEditor';
  import { initBlogEditor } from '../lib/admin/blogEditor';
  import { initAuth } from '../lib/admin/auth';

  function $(id: string) {
    return document.getElementById(id)!;
  }

  initTabs(
    [$('tab-about'), $('tab-tried'), $('tab-blog')],
    {
      about: $('panel-about'),
      tried: $('panel-tried'),
      blog: $('panel-blog'),
    }
  );

  const aboutEditor = initAboutEditor({
    aboutForm: $('about-form') as HTMLFormElement,
    aboutStatus: $('about-status'),
    name: $('a-name') as HTMLInputElement,
    role: $('a-role') as HTMLInputElement,
    now: $('a-now') as HTMLInputElement,
    portraitSrc: $('a-portrait-src') as HTMLInputElement,
    portraitAlt: $('a-portrait-alt') as HTMLInputElement,
    portraitUpload: $('a-portrait-upload') as HTMLInputElement,
    portraitUploadStatus: $('a-portrait-upload-status'),
    doingList: $('doing-list'),
    countDoing: $('count-doing'),
    addDoing: $('add-doing'),
    workList: $('work-list'),
    countWork: $('count-work'),
    addWork: $('add-work'),
    galleryList: $('gallery-list'),
    countGallery: $('count-gallery'),
    addGallery: $('add-gallery'),
    elsewhereList: $('elsewhere-list'),
    countElsewhere: $('count-elsewhere'),
    addElsewhere: $('add-elsewhere'),
  });

  const triedEditor = initTriedEditor({
    listEl: $('entry-list'),
    emptyEl: $('list-empty'),
    formWrapper: $('entry-form-wrapper'),
    form: $('entry-form') as HTMLFormElement,
    formTitle: $('form-title'),
    cancelBtn: $('cancel-edit'),
    slugNote: $('f-slug-note'),
    statusEl: $('form-status'),
    newEntryBtn: $('new-entry-button'),
    fDate: $('f-date') as HTMLInputElement,
    fTitle: $('f-title') as HTMLInputElement,
    fNote: $('f-note') as HTMLTextAreaElement,
    fOutcome: $('f-outcome') as HTMLInputElement,
    fLiked: $('f-liked') as HTMLInputElement,
    fTags: $('f-tags') as HTMLInputElement,
    fImageSrc: $('f-image-src') as HTMLInputElement,
    fImageAlt: $('f-image-alt') as HTMLInputElement,
    fPublic: $('f-public') as HTMLInputElement,
    fImageUpload: $('f-image-upload') as HTMLInputElement,
    fImageUploadStatus: $('f-image-upload-status'),
  });

  const blogEditor = initBlogEditor({
    statusEl: $('b-status'),
    tableBody: $('b-posts-body') || $('b-tbody'),
    countEl: $('b-posts-count'),
    modal: $('b-modal'),
    modalTitle: $('b-modal-title'),
    form: $('b-form') as HTMLFormElement,
    fId: $('b-id') as HTMLInputElement,
    fSlug: $('b-slug') as HTMLInputElement,
    fTitle: $('b-title') as HTMLInputElement,
    fDescription: $('b-desc') as HTMLTextAreaElement,
    fDate: $('b-date') as HTMLInputElement,
    fTags: $('b-tags') as HTMLInputElement,
    fReadingTime: $('b-reading-time') as HTMLInputElement,
    fImageSrc: $('b-image-src') as HTMLInputElement,
    fImageAlt: $('b-image-alt') as HTMLInputElement,
    fImageUpload: $('b-image-file') as HTMLInputElement,
    fImageUploadStatus: $('b-image-status'),
    fPublished: $('b-published') as HTMLInputElement,
    btnNew: $('btn-new-post') || $('b-new'),
    btnCancel: $('b-cancel'),
  });

  initAuth({
    loginSection: $('login-section'),
    adminSection: $('admin-section'),
    loginForm: $('login-form') as HTMLFormElement,
    loginError: $('login-error'),
    whoEl: $('who'),
    logoutBtn: $('logout'),
    loginEmailInput: $('login-email') as HTMLInputElement,
    loginPasswordInput: $('login-password') as HTMLInputElement,
    loginNotice: $('login-notice'),
    forgotBtn: $('forgot'),
    recoverySection: $('recovery-section'),
    recoveryForm: $('recovery-form') as HTMLFormElement,
    recoveryPassword: $('recovery-password') as HTMLInputElement,
    recoveryError: $('recovery-error'),
    onLogin: () => {
      aboutEditor.loadAboutContent();
      triedEditor.loadEntries();
      blogEditor.loadPosts();
    }
  });
</script>

<style is:global>
  /* is:global, deliberately: every row in the four About-page list editors
     and every row in the Tried entries table is built with
     document.createElement() at runtime. Astro's scoped CSS works by
     stamping a data-astro-cid attribute onto elements that exist in the
     template at build time -- anything created later in the client script
     never gets it, so a scoped style here would silently never match most
     of this page. This file is the only thing rendering on /admin, so
     there's nothing else for these class names to collide with.

     This page is also a private tool, not the public showcase --
     DESIGN.md's "no cards, hairlines only, one font" rules are deliberately
     relaxed here: panels instead of flat hairlines, a system sans instead
     of the site's serif reading face (forms aren't prose), and a danger-red
     hover on Delete. */

  /* One sans face for the entire admin surface, set on the shell rather than
     on two sections -- the header used to fall outside that pair and render
     in the site's reading serif, so the page mixed two families in one view.
     Doc.astro's prose rules are off here (prose={false}), so the type scale
     below is the only one in play. */
  .shell {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    max-width: 52rem;
  }

  header {
    margin-bottom: clamp(1.5rem, 4vw, 2rem);
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  nav a {
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .04em;
    color: var(--muted);
    text-decoration: none;
    transition: color .15s ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -.01em;
    color: var(--text);
  }

  .standfirst {
    margin: 0 0 1.25rem;
    font-size: .85rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.4rem 1.5rem;
    margin-bottom: 1.1rem;
  }

  #login-section.panel {
    max-width: 26rem;
  }

  /* ── collapsible About-page sections ── */

  details.collapsible {
    padding: 0;
    overflow: hidden;
  }

  details.collapsible summary {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: 1rem 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--mono);
    font-size: .7rem;
    font-weight: 400;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  details.collapsible summary::-webkit-details-marker {
    display: none;
  }

  details.collapsible summary:hover {
    color: var(--text);
  }

  details.collapsible .chev {
    display: inline-block;
    font-family: initial;
    font-size: .8rem;
    transition: transform .15s ease;
  }

  details.collapsible[open] .chev {
    transform: rotate(90deg);
  }

  /* A bare right-aligned digit read as a value, not a tally. The pill makes
     it obviously a count of what's inside. */
  details.collapsible .count {
    margin-left: auto;
    min-width: 1.5rem;
    padding: .12rem .45rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--muted);
    text-align: center;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  details.collapsible .panel-body {
    padding: 0 1.5rem 1.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  /* Matches the <summary> label on the collapsible panels beside it -- these
     are peers and should read as peers. Previously this lost the cascade to
     Doc.astro's 1.4rem `.shell h2`, so "Profile" rendered twice the size of
     "What I do" right next to it. */
  .panel h2 {
    margin: 0 0 1.15rem;
    font-family: var(--mono);
    font-size: .7rem;
    font-weight: 400;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: .85rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    font-size: .8rem;
    font-weight: 500;
    color: var(--muted);
  }

  label small {
    font-weight: 400;
    color: var(--faint);
  }

  label.checkbox {
    flex-direction: row;
    align-items: center;
    gap: .5rem;
    font-size: .85rem;
    justify-content: flex-start;
  }

  label.checkbox input {
    width: auto;
  }

  input,
  textarea {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: .88rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: .45rem .6rem;
    width: 100%;
    box-sizing: border-box;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
    border-color: var(--accent);
  }

  textarea {
    resize: vertical;
    line-height: 1.45;
  }

  /* ── rich text (Quill) ── */

  .rich-editor {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .rich-editor .ql-toolbar {
    border: none;
    border-bottom: 1px solid var(--border);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  .rich-editor .ql-container {
    border: none;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: .9rem;
  }

  .rich-editor .ql-editor {
    min-height: 6rem;
    color: var(--text);
