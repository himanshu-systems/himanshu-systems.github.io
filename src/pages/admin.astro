---
import Doc from '../layouts/Doc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { loadRegistry } from '../../tools/registry.mjs';
import { home, collection, routeHref } from '../lib/paths';

const { site } = await loadRegistry();
---

<Doc title="Admin" siteTitle={site.title} chrome={false} noindex wide>
  <header>
    <div class="masthead">
      <p class="eyebrow">Admin</p>
      <nav>
        <a href={home}>About</a>
        <a href={collection}>Pages</a>
        <a href={routeHref('/tried')}>Tried</a>
        <ThemeToggle />
      </nav>
    </div>
    <h1>Manage the site</h1>
    <p class="standfirst">
      Log in to edit anything on the about page or the Tried log. This page
      isn't linked from anywhere else, but that isn't what keeps it yours —
      logging in is. Saving triggers a rebuild automatically.
    </p>
  </header>

  <section id="login-section" class="panel">
    <form id="login-form">
      <label>
        <span>Email</span>
        <input type="email" id="login-email" autocomplete="username" required />
      </label>
      <label>
        <span>Password</span>
        <input type="password" id="login-password" autocomplete="current-password" required />
      </label>
      <button type="submit" class="primary">Log in</button>
      <p class="notice error" id="login-error" hidden></p>
    </form>
  </section>

  <section id="admin-section" hidden>
    <div class="admin-bar">
      <span id="who"></span>
      <button type="button" id="logout">Log out</button>
    </div>

    <div class="tabs" role="tablist">
      <button type="button" class="tab" id="tab-about" data-tab="about" aria-selected="true">About page</button>
      <button type="button" class="tab" id="tab-tried" data-tab="tried" aria-selected="false">Tried entries</button>
    </div>

    <!-- ───────────────────────── About page ───────────────────────── -->
    <div id="panel-about" class="tab-panel">
      <form id="about-form">
        <section class="panel">
          <h2>Profile</h2>

          <label>
            <span>Name</span>
            <input type="text" id="a-name" required />
          </label>

          <label>
            <span>Role <small>the big line under your name</small></span>
            <input type="text" id="a-role" required />
          </label>

          <label>
            <span>Intro</span>
            <textarea id="a-intro" rows="4" required></textarea>
          </label>

          <label>
            <span>Now <small>optional — clear it to hide the line entirely</small></span>
            <input type="text" id="a-now" />
          </label>

          <div class="grid2">
            <label>
              <span>Portrait path <small>a file already in static/images/</small></span>
              <input type="text" id="a-portrait-src" placeholder="images/portrait.jpg" />
            </label>
            <label>
              <span>Portrait alt text</span>
              <input type="text" id="a-portrait-alt" />
            </label>
          </div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <h2>What I do</h2>
            <button type="button" class="add-row" id="add-doing">+ Add row</button>
          </div>
          <div id="doing-list" class="list"></div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <h2>Selected work</h2>
            <button type="button" class="add-row" id="add-work">+ Add row</button>
          </div>
          <div id="work-list" class="list"></div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <h2>Images</h2>
            <button type="button" class="add-row" id="add-gallery">+ Add row</button>
          </div>
          <div id="gallery-list" class="list"></div>
        </section>

        <section class="panel">
          <div class="panel-head">
            <h2>Elsewhere</h2>
            <button type="button" class="add-row" id="add-elsewhere">+ Add row</button>
          </div>
          <div id="elsewhere-list" class="list"></div>
        </section>

        <div class="actions">
          <button type="submit" class="primary">Save about page</button>
        </div>
        <p class="notice" id="about-status" hidden></p>
      </form>
    </div>

    <!-- ───────────────────────── Tried entries ───────────────────────── -->
    <div id="panel-tried" class="tab-panel" hidden>
      <section class="panel">
        <p class="form-title" id="form-title">New entry</p>

        <form id="entry-form">
          <div class="grid2">
            <label>
              <span>Date</span>
              <input type="date" id="f-date" required />
            </label>
            <label class="checkbox">
              <input type="checkbox" id="f-public" />
              <span>Public — visible on the live site</span>
            </label>
          </div>

          <label>
            <span>Title</span>
            <input type="text" id="f-title" required />
          </label>

          <label>
            <span>Note <small>shows in every list and teaser</small></span>
            <textarea id="f-note" rows="2" required></textarea>
          </label>

          <label>
            <span>Description <small>optional — its own page only; a blank line starts a new paragraph</small></span>
            <textarea id="f-description" rows="5"></textarea>
          </label>

          <div class="grid2">
            <label>
              <span>Outcome</span>
              <input type="text" id="f-outcome" placeholder="worked, failed, mixed, ongoing…" required />
            </label>
            <label>
              <span>Liked</span>
              <input type="text" id="f-liked" placeholder="liked it, not for me…" required />
            </label>
          </div>

          <label>
            <span>Tags <small>comma separated</small></span>
            <input type="text" id="f-tags" placeholder="systems, security" />
          </label>

          <div class="grid2">
            <label>
              <span>Image path <small>optional — a file already in static/images/</small></span>
              <input type="text" id="f-image-src" placeholder="images/whatever.jpg" />
            </label>
            <label>
              <span>Image alt text</span>
              <input type="text" id="f-image-alt" />
            </label>
          </div>

          <p class="notice" id="f-slug-note" hidden></p>

          <div class="actions">
            <button type="submit" class="primary" id="save-button">Save</button>
            <button type="button" id="cancel-edit" hidden>Cancel edit</button>
          </div>

          <p class="notice" id="form-status" hidden></p>
        </form>
      </section>

      <h2 class="list-heading">All entries</h2>
      <ol class="rows" id="entry-list"></ol>
      <p class="empty" id="list-empty" hidden>No entries yet.</p>
    </div>
  </section>
</Doc>

<script>
  import { supabase } from '../lib/supabaseClient';
  import { uniqueSlug } from '../lib/slug';

  function $(id: string) {
    return document.getElementById(id)!;
  }

  // ───────────────────────── generic repeatable list editor ─────────────────────────

  interface FieldSpec {
    key: string;
    label: string;
    type?: 'text' | 'textarea';
    placeholder?: string;
  }

  function createListEditor(container: HTMLElement, fields: FieldSpec[]) {
    function addRow(values: Record<string, string> = {}) {
      const row = document.createElement('div');
      row.className = 'list-row';

      for (const f of fields) {
        const wrap = document.createElement('label');
        const span = document.createElement('span');
        span.textContent = f.label;
        const input = f.type === 'textarea' ? document.createElement('textarea') : document.createElement('input');
        if (input instanceof HTMLInputElement) input.type = 'text';
        if (input instanceof HTMLTextAreaElement) input.rows = 2;
        if (f.placeholder) (input as HTMLInputElement).placeholder = f.placeholder;
        input.value = values[f.key] ?? '';
        input.dataset.key = f.key;
        wrap.append(span, input);
        row.append(wrap);
      }

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'danger remove-row';
      removeBtn.textContent = 'Remove';
      removeBtn.addEventListener('click', () => row.remove());
      row.append(removeBtn);

      container.append(row);
    }

    function setItems(items: Record<string, string>[]) {
      container.innerHTML = '';
      for (const item of items) addRow(item);
    }

    function getItems(): Record<string, string>[] {
      return Array.from(container.querySelectorAll<HTMLElement>('.list-row')).map((row) => {
        const obj: Record<string, string> = {};
        for (const f of fields) {
          const el = row.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-key="${f.key}"]`);
          obj[f.key] = el?.value.trim() ?? '';
        }
        return obj;
      });
    }

    return { addRow, setItems, getItems };
  }

  const doingEditor = createListEditor($('doing-list'), [
    { key: 'label', label: 'Label' },
    { key: 'detail', label: 'Detail', type: 'textarea' },
  ]);
  $('add-doing').addEventListener('click', () => doingEditor.addRow());

  const workEditor = createListEditor($('work-list'), [
    { key: 'year', label: 'Year' },
    { key: 'title', label: 'Title' },
    { key: 'blurb', label: 'Blurb', type: 'textarea' },
    { key: 'href', label: 'Link (optional)' },
  ]);
  $('add-work').addEventListener('click', () => workEditor.addRow());

  const galleryEditor = createListEditor($('gallery-list'), [
    { key: 'src', label: 'Image path' },
    { key: 'alt', label: 'Alt text' },
    { key: 'caption', label: 'Caption (optional)' },
  ]);
  $('add-gallery').addEventListener('click', () => galleryEditor.addRow());

  const elsewhereEditor = createListEditor($('elsewhere-list'), [
    { key: 'label', label: 'Label' },
    { key: 'text', label: 'Text' },
    { key: 'href', label: 'Link' },
  ]);
  $('add-elsewhere').addEventListener('click', () => elsewhereEditor.addRow());

  // ───────────────────────── tabs ─────────────────────────

  const tabButtons = [$('tab-about'), $('tab-tried')];
  const tabPanels: Record<string, HTMLElement> = { about: $('panel-about'), tried: $('panel-tried') };

  for (const btn of tabButtons) {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;
      for (const b of tabButtons) b.setAttribute('aria-selected', String(b === btn));
      for (const [name, panel] of Object.entries(tabPanels)) panel.hidden = name !== target;
    });
  }

  // ───────────────────────── about page form ─────────────────────────

  const aboutForm = $('about-form') as HTMLFormElement;
  const aboutStatus = $('about-status');

  const aboutFields = {
    name: $('a-name') as HTMLInputElement,
    role: $('a-role') as HTMLInputElement,
    intro: $('a-intro') as HTMLTextAreaElement,
    now: $('a-now') as HTMLInputElement,
    portraitSrc: $('a-portrait-src') as HTMLInputElement,
    portraitAlt: $('a-portrait-alt') as HTMLInputElement,
  };

  async function loadAboutContent() {
    const { data, error } = await supabase.from('site_content').select('*').eq('id', 1).single();
    if (error) {
      aboutStatus.textContent = `Could not load: ${error.message}`;
      aboutStatus.hidden = false;
      aboutStatus.classList.add('error');
      return;
    }

    aboutFields.name.value = data.name ?? '';
    aboutFields.role.value = data.role ?? '';
    aboutFields.intro.value = data.intro ?? '';
    aboutFields.now.value = data.now ?? '';
    aboutFields.portraitSrc.value = data.portrait_src ?? '';
    aboutFields.portraitAlt.value = data.portrait_alt ?? '';

    doingEditor.setItems(data.doing ?? []);
    workEditor.setItems(data.work ?? []);
    galleryEditor.setItems(data.gallery ?? []);
    elsewhereEditor.setItems(data.elsewhere ?? []);
  }

  aboutForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const payload = {
      id: 1,
      name: aboutFields.name.value.trim(),
      role: aboutFields.role.value.trim(),
      intro: aboutFields.intro.value.trim(),
      now: aboutFields.now.value.trim(),
      portrait_src: aboutFields.portraitSrc.value.trim() || null,
      portrait_alt: aboutFields.portraitAlt.value.trim() || null,
      doing: doingEditor.getItems(),
      work: workEditor.getItems().map((w) => ({ ...w, href: w.href || null })),
      gallery: galleryEditor.getItems(),
      elsewhere: elsewhereEditor.getItems(),
    };

    const { error } = await supabase.from('site_content').upsert(payload);
    aboutStatus.hidden = false;
    aboutStatus.classList.toggle('error', Boolean(error));
    aboutStatus.textContent = error
      ? `Could not save: ${error.message}`
      : 'Saved. The site will rebuild in about a minute.';
  });

  // ───────────────────────── tried entries ─────────────────────────

  interface AdminEntry {
    id: string;
    slug: string;
    date: string;
    title: string;
    note: string;
    description: string | null;
    image_src: string | null;
    image_alt: string | null;
    outcome: string;
    liked: string;
    tags: string[];
    is_public: boolean;
  }

  const listEl = $('entry-list');
  const emptyEl = $('list-empty');

  const form = $('entry-form') as HTMLFormElement;
  const formTitle = $('form-title');
  const cancelBtn = $('cancel-edit');
  const slugNote = $('f-slug-note');
  const statusEl = $('form-status');

  const fields = {
    date: $('f-date') as HTMLInputElement,
    title: $('f-title') as HTMLInputElement,
    note: $('f-note') as HTMLTextAreaElement,
    description: $('f-description') as HTMLTextAreaElement,
    outcome: $('f-outcome') as HTMLInputElement,
    liked: $('f-liked') as HTMLInputElement,
    tags: $('f-tags') as HTMLInputElement,
    imageSrc: $('f-image-src') as HTMLInputElement,
    imageAlt: $('f-image-alt') as HTMLInputElement,
    isPublic: $('f-public') as HTMLInputElement,
  };

  let entries: AdminEntry[] = [];
  let editingId: string | null = null;

  function setStatus(message: string, isError = false) {
    statusEl.textContent = message;
    statusEl.hidden = false;
    statusEl.classList.toggle('error', isError);
  }

  function resetForm() {
    editingId = null;
    form.reset();
    formTitle.textContent = 'New entry';
    cancelBtn.hidden = true;
    slugNote.hidden = true;
  }

  function startEdit(entry: AdminEntry) {
    editingId = entry.id;
    fields.date.value = entry.date;
    fields.title.value = entry.title;
    fields.note.value = entry.note;
    fields.description.value = entry.description ?? '';
    fields.outcome.value = entry.outcome;
    fields.liked.value = entry.liked;
    fields.tags.value = entry.tags.join(', ');
    fields.imageSrc.value = entry.image_src ?? '';
    fields.imageAlt.value = entry.image_alt ?? '';
    fields.isPublic.checked = entry.is_public;
    formTitle.textContent = `Editing "${entry.title}"`;
    cancelBtn.hidden = false;
    slugNote.hidden = false;
    slugNote.textContent = `URL: /tried/${entry.slug}/ — fixed once an entry exists, so links already shared never break.`;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function loadEntries() {
    const { data, error } = await supabase
      .from('tried_entries')
      .select('*')
      .order('date', { ascending: false })
      .order('created_at', { ascending: false });

    if (error) {
      setStatus(`Could not load entries: ${error.message}`, true);
      return;
    }
    entries = (data ?? []) as AdminEntry[];
    renderList();
  }

  function renderList() {
    listEl.innerHTML = '';
    emptyEl.hidden = entries.length !== 0;

    for (const entry of entries) {
      const li = document.createElement('li');
      li.className = 'row';

      const main = document.createElement('div');
      main.className = 'entry-main';

      const date = document.createElement('span');
      date.className = 'date';
      date.textContent = entry.date;

      const body = document.createElement('span');
      body.className = 'body';
      const title = document.createElement('span');
      title.className = 'title';
      title.textContent = entry.title;
      const note = document.createElement('span');
      note.className = 'blurb';
      note.textContent = entry.note;
      body.append(title, note);

      const status = document.createElement('span');
      status.className = entry.is_public ? 'tag tag-public' : 'tag tag-private';
      status.textContent = entry.is_public ? 'public' : 'private';

      main.append(date, body, status);

      const actions = document.createElement('div');
      actions.className = 'entry-actions';

      const toggleBtn = document.createElement('button');
      toggleBtn.type = 'button';
      toggleBtn.textContent = entry.is_public ? 'Make private' : 'Publish';
      toggleBtn.addEventListener('click', () => togglePublic(entry));

      const editBtn = document.createElement('button');
      editBtn.type = 'button';
      editBtn.textContent = 'Edit';
      editBtn.addEventListener('click', () => startEdit(entry));

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'danger';
      deleteBtn.textContent = 'Delete';
      deleteBtn.addEventListener('click', () => deleteEntry(entry));

      actions.append(toggleBtn, editBtn, deleteBtn);
      li.append(main, actions);
      listEl.append(li);
    }
  }

  async function togglePublic(entry: AdminEntry) {
    const { error } = await supabase
      .from('tried_entries')
      .update({ is_public: !entry.is_public })
      .eq('id', entry.id);

    if (error) {
      setStatus(`Could not update: ${error.message}`, true);
      return;
    }
    setStatus('Saved. The site will rebuild in about a minute.');
    loadEntries();
  }

  async function deleteEntry(entry: AdminEntry) {
    if (!confirm(`Delete "${entry.title}"? This can't be undone.`)) return;

    const { error } = await supabase.from('tried_entries').delete().eq('id', entry.id);
    if (error) {
      setStatus(`Could not delete: ${error.message}`, true);
      return;
    }
    if (editingId === entry.id) resetForm();
    setStatus('Deleted. The site will rebuild in about a minute.');
    loadEntries();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const payload = {
      date: fields.date.value,
      title: fields.title.value.trim(),
      note: fields.note.value.trim(),
      description: fields.description.value.trim() || null,
      outcome: fields.outcome.value.trim(),
      liked: fields.liked.value.trim(),
      tags: fields.tags.value
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean),
      image_src: fields.imageSrc.value.trim() || null,
      image_alt: fields.imageAlt.value.trim() || null,
      is_public: fields.isPublic.checked,
    };

    if (editingId) {
      const { error } = await supabase.from('tried_entries').update(payload).eq('id', editingId);
      if (error) {
        setStatus(`Could not save: ${error.message}`, true);
        return;
      }
    } else {
      const taken = new Set(entries.map((e) => e.slug));
      const slug = uniqueSlug(payload.title, taken);
      const { error } = await supabase.from('tried_entries').insert({ ...payload, slug });
      if (error) {
        setStatus(`Could not save: ${error.message}`, true);
        return;
      }
    }

    setStatus('Saved. The site will rebuild in about a minute.');
    resetForm();
    loadEntries();
  });

  cancelBtn.addEventListener('click', resetForm);

  // ───────────────────────── auth ─────────────────────────

  const loginSection = $('login-section');
  const adminSection = $('admin-section');
  const loginForm = $('login-form') as HTMLFormElement;
  const loginError = $('login-error');
  const whoEl = $('who');

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    loginError.hidden = true;
    const email = ($('login-email') as HTMLInputElement).value;
    const password = ($('login-password') as HTMLInputElement).value;
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) {
      loginError.textContent = error.message;
      loginError.hidden = false;
    }
  });

  $('logout').addEventListener('click', () => {
    supabase.auth.signOut();
  });

  function showLoggedOut() {
    loginSection.hidden = false;
    adminSection.hidden = true;
  }

  function showLoggedIn(email: string) {
    loginSection.hidden = true;
    adminSection.hidden = false;
    whoEl.textContent = email;
    loadAboutContent();
    loadEntries();
  }

  supabase.auth.getSession().then(({ data }) => {
    if (data.session?.user.email) showLoggedIn(data.session.user.email);
    else showLoggedOut();
  });

  supabase.auth.onAuthStateChange((_event, session) => {
    if (session?.user.email) showLoggedIn(session.user.email);
    else showLoggedOut();
  });
</script>

<style is:global>
  /* is:global, deliberately: every row in the four list editors and every
     row in the Tried entry list is built with document.createElement() at
     runtime. Astro's scoped CSS works by stamping a data-astro-cid
     attribute onto elements that exist in the template at build time --
     anything created later in the client script never gets it, so a
     scoped style here would silently never match most of this page. This
     file is the only thing rendering on /admin, so there's nothing else
     for these class names to collide with. */
  /* This page is a private tool, not the public showcase -- DESIGN.md's
     "no cards, hairlines only" rule is deliberately relaxed here. Panels
     make a form with this many fields scannable in a way flat text can't.
     Same reasoning for typography: the site's serif is a reading face, and
     everything here is a form field or a button, not prose to read. A
     system sans keeps every label and input reading as UI, not an essay
     with boxes glued onto it. Every rule below that needs it repeats the
     same literal stack -- Astro scopes styles per-component, so a custom
     property would need a real element to hang off, which is more
     indirection than five repeated font-family lines are worth. */

  /* Everything below the header is UI, not prose -- override the shell's
     serif default here rather than on each individual rule. The nav links,
     buttons, dates, and tags below all set --mono explicitly already, so
     they still win over this on the cascade. */
  #login-section,
  #admin-section {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  header {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  nav a {
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .04em;
    color: var(--muted);
    text-decoration: none;
    transition: color .15s ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  h1 {
    margin: 0 0 .5rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -.01em;
    color: var(--text);
  }

  .standfirst {
    margin: 0;
    max-width: 34rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: .88rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.75rem;
    margin-bottom: 1.75rem;
    max-width: 40rem;
  }

  #login-section.panel {
    max-width: 24rem;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .panel h2,
  h2.list-heading {
    margin: 0 0 1.25rem;
    font-family: var(--mono);
    font-size: .7rem;
    font-weight: 400;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .panel-head h2 {
    margin: 0;
  }

  h2.list-heading {
    margin: 2.5rem 0 1rem;
    padding-bottom: .7rem;
    border-bottom: 1px solid var(--border-strong);
    max-width: 40rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  label {
    display: flex;
