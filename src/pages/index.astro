---
import Doc from "../layouts/Doc.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { loadRegistry } from "../../tools/registry.mjs";
import { asset, collection, routeHref } from "../lib/paths";
import { me } from "../data/me";
import { triedRows } from "../lib/tried";

const { site } = await loadRegistry();

// Newest 3, as a teaser -- the full, filterable log lives at /tried.
const recentlyTried = triedRows.slice(0, 3);
---

<Doc
  title={me.name}
  siteTitle={site.title}
  description={`${me.name} — ${me.role}`}
  chrome={false}
  wide
>
  <header>
    <div class="masthead">
      <p class="eyebrow">{me.name}</p>
      <nav>
        <a href={collection}>Pages</a>
        <ThemeToggle />
      </nav>
    </div>

    <div class="lede">
      <div class="lede-text">
        <h1>{me.role}</h1>
        <p class="intro">{me.intro}</p>
        {
          me.now && (
            <p class="now">
              <span class="now-label">Now</span>
              {me.now}
            </p>
          )
        }
      </div>
      {
        me.portrait && (
          <img
            class="portrait"
            src={asset(me.portrait.src)}
            alt={me.portrait.alt}
            width="640"
            height="800"
          />
        )
      }
    </div>
  </header>

  {
    me.doing.length > 0 && (
      <section>
        <h2>What I do</h2>
        <dl class="rows">
          {me.doing.map((item) => (
            <div class="row pair">
              <dt>{item.label}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    me.work.length > 0 && (
      <section>
        <h2>Selected work</h2>
        <ol class="rows">
          {me.work.map((item) => {
            const Tag = item.href ? "a" : "div";
            return (
              <li class="row">
                <Tag
                  class="pair"
                  href={item.href ?? undefined}
                  rel={item.href ? "noopener noreferrer" : undefined}
                >
                  <span class="year">{item.year}</span>
                  <span class="body">
                    <span class="title">{item.title}</span>
                    <span class="blurb">{item.blurb}</span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  {
    recentlyTried.length > 0 && (
      <section>
        <h2>Tried</h2>
        <ol class="rows">
          {recentlyTried.map((item) => (
            <li class="row">
              <a class="entry" href={item.href}>
                <span class="date">{item.date}</span>
                <span class="body">
                  <span class="title">{item.title}</span>
                  {item.note && <span class="blurb">{item.note}</span>}
                </span>
                <span class="tags">
                  {item.outcome && <span class="tag">{item.outcome}</span>}
                  {item.liked && (
                    <span class="tag tag-liked">{item.liked}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="more">
          <a href={routeHref("/tried")}>
            See everything I&rsquo;ve tried &rarr;
          </a>
        </p>
      </section>
    )
  }

  {
    me.gallery.length > 0 && (
      <section>
        <h2>Images</h2>
        <ul class="gallery">
          {me.gallery.map((item) => (
            <li>
              <img
                src={asset(item.src)}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              {item.caption && <p class="caption">{item.caption}</p>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    me.elsewhere.length > 0 && (
      <section>
        <h2>Elsewhere</h2>
        <ul class="rows">
          {me.elsewhere.map((item) => (
            <li class="row">
              <a class="pair" href={item.href} rel="noopener noreferrer">
                <span class="label">{item.label}</span>
                <span class="text">{item.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Doc>

<style>
  header {
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  nav a {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  /* Text left, portrait right; stacks below the breakpoint. */
  .lede {
    display: grid;
    grid-template-columns: 1fr 13rem;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  h1 {
    margin: 0 0 1.2rem;
    max-width: var(--measure);
  }

  .intro {
    margin: 0;
    max-width: var(--measure);
    font-size: 1.05rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .now {
    margin: 1.6rem 0 0;
    max-width: var(--measure);
    font-size: 0.95rem;
    color: var(--muted);
  }

  .now-label {
    display: inline-block;
    margin-right: 0.6rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    vertical-align: 0.1em;
  }

  /* Section headings borrow the index's mono label, not the prose h2. */
  section {
    margin-top: clamp(2.75rem, 6vw, 4rem);
  }

  h2 {
    margin: 0;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border-strong);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  /* The single grid shape, applied to the element that actually holds the two
     columns — never to both a wrapper and its child, which nests one grid
     inside the other's first column and squashes the row. */
  .pair {
    display: grid;
    grid-template-columns: 10rem 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 0;
    text-decoration: none;
  }

  a.pair {
    transition: background-color 0.15s ease;
  }

  a.pair:hover {
    /* Same bleed as the collection rows: the whole row is the target. */
    background: var(--accent-soft);
    box-shadow:
      -1rem 0 0 var(--accent-soft),
      1rem 0 0 var(--accent-soft);
  }

  dt,
  .year,
  .label {
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.15s ease;
  }

  a.pair:hover .year,
  a.pair:hover .label {
    color: var(--accent);
  }

  dd {
    margin: 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .blurb {
    font-size: 0.92rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .text {
    color: var(--text);
    font-size: 0.98rem;
    word-break: break-word;
  }

  /* Three columns: date, then the two-line body, then the outcome/liked pair
     stacked and right-aligned — the same shape as the collection index's
     meta column. Links out to the entry's own page at /tried/<slug>. */
  .entry {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 0;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .entry:hover {
    background: var(--accent-soft);
    box-shadow:
      -1rem 0 0 var(--accent-soft),
      1rem 0 0 var(--accent-soft);
  }

  .date {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.15s ease;
  }

  .entry:hover .date {
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    text-align: right;
    white-space: nowrap;
  }

  .tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
    transition: color 0.15s ease;
  }

  .entry:hover .tag {
    color: var(--accent);
  }

  .tag-liked {
    color: var(--muted);
  }

  .gallery {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem;
  }

  .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .caption {
    margin: 0.6rem 0 0;
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--faint);
    text-wrap: pretty;
  }

  .more {
    margin: 1.4rem 0 0;
  }

  .more a {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .more a:hover {
    color: var(--accent);
  }

  /* The one breakpoint, matching the collection index. */
  @media (max-width: 46rem) {
    .lede {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 11rem;
      order: -1;
      margin-bottom: 0.5rem;
    }

    .pair {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1rem 0;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1rem 0;
    }

    .tags {
      flex-direction: row;
      align-items: baseline;
      gap: 0.8rem;
      text-align: left;
    }

    a.pair:hover,
    .entry:hover {
      box-shadow:
        -0.75rem 0 0 var(--accent-soft),
        0.75rem 0 0 var(--accent-soft);
    }
  }
</style>
