---
import Doc from '../layouts/Doc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { loadRegistry } from '../../tools/registry.mjs';
import { asset, collection, routeHref } from '../lib/paths';
import { tried } from '../data/tried';

const { site } = await loadRegistry();

// Newest 3, as a teaser -- the full, filterable log lives at /tried.
const recentlyTried = tried.slice(0, 3);

/* ────────────────────────────────────────────────────────────────────────────
 * EDIT EVERYTHING IN THIS BLOCK. Nothing below it needs to change.
 *
 * The placeholder prose describes what to write rather than inventing a bio.
 * Replace it before you show this page to anyone. Empty any array to drop that
 * section entirely — its heading disappears with it.
 *
 * Images live in static/, which is copied to the site root at build time.
 * So static/images/portrait.jpg is written here as 'images/portrait.jpg'.
 *
 * The Tried teaser below is not edited here -- it and the full list at
 * /tried both read from src/data/tried.ts. Edit entries there.
 * ──────────────────────────────────────────────────────────────────────────── */
const me = {
  name: 'Himanshu Chavda',

  /* One line, under your name. What you do, in plain words. */
  role: 'I turn simple questions into unnecessarily deep problems.',

  /* Two or three sentences. What you care about, what you are working toward,
     how you got here. Keep it plain — this is the part people actually read. */
  intro:
    'I research things, work out how they actually work, then build around what ' +
    'I learn. Backend systems, networking, operating systems, databases, ' +
    'distributed systems, security, Rust, Go — whatever has my attention that ' +
    'week. I want the big picture and the smallest mechanism, which is how I ' +
    'end up with ten unfinished things and twenty more I want to start.',

  /* Optional. One line about what is on your desk right now. '' hides it. */
  now: 'Somewhere between building something useful and following an idea just to see where it goes.',

  /* Optional. Set to null for no portrait. alt is read aloud by screen readers,
     so describe the picture rather than repeating your name. */
  portrait: { src: 'images/portrait.jpg', alt: 'Portrait photo' },

  /* Left column is the area, right column is the detail. */
  doing: [
    { label: 'systems', detail: 'Backend, operating systems, distributed systems, and the networking underneath.' },
    { label: 'data', detail: 'Databases, and what is actually happening below the query.' },
    { label: 'security', detail: 'How things break, and what that says about how they were built.' },
    { label: 'languages', detail: 'Rust and Go, mostly.' },
    { label: 'method', detail: 'Start with a question. Read until it makes sense. Build something with it.' },
  ],

  /* Set href to null for anything that has no link yet. */
  work: [
    {
      year: '2026',
      title: 'HTML DOCS TO Learn',
      blurb: 'A single GitHub Pages site that serves both hand-written pages and imported HTML, driven by one registry file.',
      href: 'https://github.com/himanshu-systems/himanshu-systems.github.io',
    },
    {
      year: '20XX',
      title: 'Another project',
      blurb: 'One sentence on what it does and why you built it.',
      href: null,
    },
  ],

  /* Screenshots, photos, anything visual. Drop files into static/images/ and
     point at them here. Captions are optional. */
  gallery: [
    { src: 'images/work-1.svg', alt: 'Placeholder image one', caption: 'A caption, if it needs one.' },
    { src: 'images/work-2.svg', alt: 'Placeholder image two', caption: '' },
    { src: 'images/work-3.svg', alt: 'Placeholder image three', caption: '' },
  ],

  /* Remove the email line if you would rather not have it scraped. */
  elsewhere: [
    { label: 'github', text: '@himanshu-systems', href: 'https://github.com/himanshu-systems' },
    { label: 'email', text: 'himanshuchavdacodes@gmail.com', href: 'mailto:himanshuchavdacodes@gmail.com' },
  ],
};
/* ──────────────────────────────────────────────────────────────────────────── */
---

<Doc
  title={me.name}
  siteTitle={site.title}
  description={`${me.name} — ${me.role}`}
  chrome={false}
  wide
>
  <header>
    <div class="masthead">
      <p class="eyebrow">{me.name}</p>
      <nav>
        <a href={collection}>Pages</a>
        <ThemeToggle />
      </nav>
    </div>

    <div class="lede">
      <div class="lede-text">
        <h1>{me.role}</h1>
        <p class="intro">{me.intro}</p>
        {me.now && (
          <p class="now">
            <span class="now-label">Now</span>
            {me.now}
          </p>
        )}
      </div>
      {me.portrait && (
        <div class="portrait-frame" title="Hover for the real colours">
          <img class="portrait" src={asset(me.portrait.src)} alt={me.portrait.alt} width="640" height="800" />
        </div>
      )}
    </div>
  </header>

  {
    me.doing.length > 0 && (
      <section>
        <h2>What I do</h2>
        <dl class="rows">
          {me.doing.map((item) => (
            <div class="row pair">
              <dt>{item.label}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    me.work.length > 0 && (
      <section>
        <h2>Selected work</h2>
        <ol class="rows">
          {me.work.map((item) => {
            const Tag = item.href ? 'a' : 'div';
            return (
              <li class="row">
                <Tag class="pair" href={item.href ?? undefined} rel={item.href ? 'noopener noreferrer' : undefined}>
                  <span class="year">{item.year}</span>
                  <span class="body">
                    <span class="title">{item.title}</span>
                    <span class="blurb">{item.blurb}</span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  {
    recentlyTried.length > 0 && (
      <section>
        <h2>Tried</h2>
        <ol class="rows">
          {recentlyTried.map((item) => (
            <li class="row entry">
              <span class="date">{item.date}</span>
              <span class="body">
                <span class="title">{item.title}</span>
                {item.note && <span class="blurb">{item.note}</span>}
              </span>
              <span class="tags">
                {item.outcome && <span class="tag">{item.outcome}</span>}
                {item.liked && <span class="tag tag-liked">{item.liked}</span>}
              </span>
            </li>
          ))}
        </ol>
        <p class="more">
          <a href={routeHref('/tried')}>See everything I&rsquo;ve tried &rarr;</a>
        </p>
      </section>
    )
  }

  {
    me.gallery.length > 0 && (
      <section>
        <h2>Images</h2>
        <ul class="gallery">
          {me.gallery.map((item) => (
            <li>
              <img src={asset(item.src)} alt={item.alt} loading="lazy" decoding="async" />
              {item.caption && <p class="caption">{item.caption}</p>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    me.elsewhere.length > 0 && (
      <section>
        <h2>Elsewhere</h2>
        <ul class="rows">
          {me.elsewhere.map((item) => (
            <li class="row">
              <a class="pair" href={item.href} rel="noopener noreferrer">
                <span class="label">{item.label}</span>
                <span class="text">{item.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Doc>

<style>
  header {
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  nav a {
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .04em;
    color: var(--muted);
    text-decoration: none;
    transition: color .15s ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  /* Text left, portrait right; stacks below the breakpoint. */
  .lede {
    display: grid;
    grid-template-columns: 1fr 13rem;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .portrait-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  /* An --accent-tinted layer over a grayscale photo: a duotone that always
     matches the site's own palette, and shifts with it between themes. */
  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    mix-blend-mode: color;
    opacity: .55;
    transition: opacity .5s ease;
  }

  .portrait-frame:hover::after,
  .portrait-frame:active::after {
    opacity: 0;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    filter: grayscale(1) contrast(1.05);
    transition: filter .5s ease;
  }

  .portrait-frame:hover .portrait,
  .portrait-frame:active .portrait {
    filter: grayscale(0) contrast(1);
  }

  h1 {
    margin: 0 0 1.2rem;
    max-width: var(--measure);
  }

  .intro {
    margin: 0;
    max-width: var(--measure);
    font-size: 1.05rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .now {
    margin: 1.6rem 0 0;
    max-width: var(--measure);
    font-size: .95rem;
    color: var(--muted);
  }

  .now-label {
    display: inline-block;
    margin-right: .6rem;
    font-family: var(--mono);
    font-size: .62rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    vertical-align: .1em;
  }

  /* Section headings borrow the index's mono label, not the prose h2. */
  section {
    margin-top: clamp(2.75rem, 6vw, 4rem);
  }

  h2 {
    margin: 0;
    padding-bottom: .7rem;
    border-bottom: 1px solid var(--border-strong);
    font-family: var(--mono);
    font-size: .7rem;
    font-weight: 400;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  /* The single grid shape, applied to the element that actually holds the two
     columns — never to both a wrapper and its child, which nests one grid
     inside the other's first column and squashes the row. */
  .pair {
    display: grid;
    grid-template-columns: 10rem 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 0;
    text-decoration: none;
  }

  a.pair {
    transition: background-color .15s ease;
  }

  a.pair:hover {
    /* Same bleed as the collection rows: the whole row is the target. */
    background: var(--accent-soft);
    box-shadow: -1rem 0 0 var(--accent-soft), 1rem 0 0 var(--accent-soft);
  }

  dt,
  .year,
  .label {
    font-family: var(--mono);
    font-size: .76rem;
    letter-spacing: .02em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color .15s ease;
  }

  a.pair:hover .year,
  a.pair:hover .label {
    color: var(--accent);
  }

  dd {
    margin: 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: .3rem;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.01em;
    color: var(--text);
  }

  .blurb {
    font-size: .92rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .text {
    color: var(--text);
    font-size: .98rem;
    word-break: break-word;
  }

  /* Three columns: date, then the two-line body, then the outcome/liked pair
     stacked and right-aligned — the same shape as the collection index's
     meta column. Not a link, so no hover state. */
  .entry {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 0;
  }

  .date {
    font-family: var(--mono);
    font-size: .76rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .3rem;
    text-align: right;
    white-space: nowrap;
  }

  .tag {
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .tag-liked {
    color: var(--muted);
  }

  .gallery {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem;
  }

  .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .caption {
    margin: .6rem 0 0;
    font-family: var(--mono);
    font-size: .68rem;
    line-height: 1.5;
    letter-spacing: .02em;
    color: var(--faint);
    text-wrap: pretty;
  }

  .more {
    margin: 1.4rem 0 0;
  }

  .more a {
    font-family: var(--mono);
    font-size: .78rem;
    letter-spacing: .02em;
    color: var(--muted);
    text-decoration: none;
    transition: color .15s ease;
  }

  .more a:hover {
    color: var(--accent);
  }

  /* The one breakpoint, matching the collection index. */
  @media (max-width: 46rem) {
    .lede {
      grid-template-columns: 1fr;
    }

    .portrait-frame {
      max-width: 11rem;
      order: -1;
      margin-bottom: .5rem;
    }

    .pair {
      grid-template-columns: 1fr;
      gap: .4rem;
      padding: 1rem 0;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: .4rem;
      padding: 1rem 0;
    }

    .tags {
      flex-direction: row;
      align-items: baseline;
      gap: .8rem;
      text-align: left;
    }

    a.pair:hover {
      box-shadow: -.75rem 0 0 var(--accent-soft), .75rem 0 0 var(--accent-soft);
    }
  }
</style>
