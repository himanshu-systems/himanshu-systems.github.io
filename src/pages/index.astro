---
import Doc from "../layouts/Doc.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SocialIcon from "../components/SocialIcon.astro";
import AsciiTitle from "../components/AsciiTitle.astro";
import RipplePhoto from "../components/RipplePhoto.astro";
import { loadRegistry } from "../../tools/registry.mjs";
import { asset, resolveImage, collection, routeHref } from "../lib/paths";
import { getSiteContent } from "../lib/site";
import { getTriedRows } from "../lib/tried";

const { site } = await loadRegistry();
const me = await getSiteContent();

// Newest 3, as a teaser -- the full, filterable log lives at /tried.
const recentlyTried = (await getTriedRows()).slice(0, 3);

// Top 3 only -- a homepage teaser, not the full project history.
const selectedWork = me.work.slice(0, 3);
---

<Doc
  title={me.name}
  siteTitle={site.title}
  description={`${me.name} — ${me.role}`}
  chrome={false}
  wide
>
  <header>
    <div class="masthead">
      <p class="eyebrow">{me.name}</p>
      <nav>
        <a href={collection}>Pages</a>
        <ThemeToggle />
      </nav>
    </div>

    <div class="lede">
      <div class="lede-text">
        <AsciiTitle>
          <h1>{me.role}</h1>
        </AsciiTitle>
        <div class="intro" set:html={me.intro} />
        {
          me.now && (
            <p class="now">
              <span class="now-label">
                <span class="live-dot" aria-hidden="true"></span>
                Now
              </span>
              {me.now}
            </p>
          )
        }
      </div>
      {
        me.portrait && (
          <div class="portrait">
            <RipplePhoto src={me.portrait.src} alt={me.portrait.alt} />
          </div>
        )
      }
    </div>
  </header>

  {
    me.doing.length > 0 && (
      <section>
        <h2>What I do</h2>
        <dl class="rows">
          {me.doing.map((item) => (
            <div class="row pair">
              <dt>{item.label}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    selectedWork.length > 0 && (
      <section>
        <h2>Selected work</h2>
        <ol class="rows">
          {selectedWork.map((item) => {
            const Tag = item.href ? "a" : "div";
            return (
              <li class="row">
                <Tag
                  class="pair"
                  href={item.href ?? undefined}
                  rel={item.href ? "noopener noreferrer" : undefined}
                >
                  <span class="year">{item.year}</span>
                  <span class="body">
                    <span class="title">{item.title}</span>
                    <span class="blurb">{item.blurb}</span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  {
    recentlyTried.length > 0 && (
      <section>
        <h2>Tried</h2>
        <ol class="rows">
          {recentlyTried.map((item) => (
            <li class="row">
              <a class="entry" href={item.href}>
                <span class="date">{item.date}</span>
                <span class="body">
                  <span class="title">{item.title}</span>
                  {item.note && <span class="blurb">{item.note}</span>}
                </span>
                <span class="tags">
                  {item.outcome && <span class="tag">{item.outcome}</span>}
                  {item.liked && (
                    <span class="tag tag-liked">{item.liked}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="more">
          <a href={routeHref("/tried")}>
            See everything I&rsquo;ve tried &rarr;
          </a>
        </p>
      </section>
    )
  }

  {
    me.gallery.length > 0 && (
      <section>
        <h2>Images</h2>
        <ul class="gallery">
          {me.gallery.map((item) => (
            <li>
              <img
                src={resolveImage(item.src)}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              {item.caption && <p class="caption">{item.caption}</p>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    me.elsewhere.length > 0 && (
      <section>
        <h2>Elsewhere</h2>
        <div class="social-row">
          {me.elsewhere.map((item) => (
            <a
              class="social-icon"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              title={`${item.label}: ${item.text}`}
              aria-label={`${item.label}: ${item.text}`}
            >
              <SocialIcon label={item.label} />
            </a>
          ))}
        </div>
      </section>
    )
  }
</Doc>

<style>
  header {
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  nav a {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  /* Text left, portrait right; stacks below the breakpoint. */
  .lede {
    display: grid;
    grid-template-columns: 1fr 13rem;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  /* The frame only. The photo inside is a RipplePhoto, which fills this box
     and owns its own object-fit; overflow keeps the radius clipping both the
     image and the effect canvas stacked on it. */
  .portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  h1 {
    margin: 0 0 1.2rem;
    max-width: var(--measure);
  }

  /* Rendered via set:html from Quill in /admin, so the paragraph/list/link
     tags inside are raw content, not part of this template -- Astro only
     scopes elements it compiles itself, so the descendant selectors below
     have to opt out of scoping with :global() to reach them at all. */
  .intro {
    margin: 0;
    max-width: var(--measure);
    font-size: 1.05rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .intro :global(p) {
    margin: 0 0 .9em;
  }

  .intro :global(p:last-child) {
    margin-bottom: 0;
  }

  .intro :global(a) {
    color: inherit;
    text-decoration-color: var(--border-strong);
  }

  .intro :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .intro :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .intro :global(ul),
  .intro :global(ol) {
    margin: 0 0 .9em;
    padding-left: 1.2rem;
  }

  .now {
    margin: 1.6rem 0 0;
    max-width: var(--measure);
    font-size: 0.95rem;
    color: var(--muted);
  }

  .now-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    margin-right: 0.6rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    vertical-align: 0.1em;
  }

  /* A small glowing, blurred light next to "Now" -- reads as "live" the way
     a recording or on-air indicator does. The blur comes from the box-shadow
     radius, not an actual filter, so the dot itself stays a crisp point of
     light inside a soft bloom. */
  .live-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 5px 1px var(--accent),
      0 0 12px 4px var(--accent-soft);
    animation: live-glow 2.6s ease-in-out infinite;
  }

  @keyframes live-glow {
    0%, 100% {
      opacity: 0.65;
      box-shadow:
        0 0 3px 1px var(--accent),
        0 0 8px 3px var(--accent-soft);
    }
    50% {
      opacity: 1;
      box-shadow:
        0 0 7px 2px var(--accent),
        0 0 16px 6px var(--accent-soft);
    }
  }

  /* Section headings borrow the index's mono label, not the prose h2. */
  section {
    margin-top: clamp(2.75rem, 6vw, 4rem);
    counter-increment: section;
    position: relative;
  }

  /* Editorial numerals hung in the left margin -- 01, 02, 03 down the page,
     the way a technical manual or a contents page numbers its parts. Set in
     --border-strong rather than --faint so they stay quieter than the labels
     they number. Dropped below the breakpoint, where there's no margin left
     to hang anything in. */
  h2::before {
    content: counter(section, decimal-leading-zero);
    position: absolute;
    left: -3.25rem;
    top: -0.05rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--border-strong);
    font-variant-numeric: tabular-nums;
  }

  h2 {
    margin: 0;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border-strong);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  /* The single grid shape, applied to the element that actually holds the two
     columns — never to both a wrapper and its child, which nests one grid
     inside the other's first column and squashes the row. */
  .pair {
    display: grid;
    grid-template-columns: 10rem 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 0;
    text-decoration: none;
  }

  a.pair {
    transition: background-color 0.15s ease;
  }

  a.pair:hover {
    background: var(--accent-soft);
  }

  dt,
  .year {
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.15s ease;
  }

  a.pair:hover .year {
    color: var(--accent);
  }

  /* Leader dots, index-style -- only on What I do, which is a real
     definition list (term → definition) and reads like a glossary. The
     chronological lists next to it (Selected work, Tried) get none: dots
     between a date and a title would be decoration, not navigation.

     The dots are a flex-grown pseudo-element rather than a run of typed
     periods, so they always terminate exactly at the column edge no matter
     how long the term is -- a fixed string of periods stops wherever it
     happens to stop, which is what makes hand-typed leaders look broken.
     dt is a flex container, so the bare text node becomes an anonymous
     flex item and ::after takes the remaining space. */
  dt {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  dt::after {
    content: "";
    flex: 1;
    border-bottom: 1px dotted var(--border-strong);
    transform: translateY(-0.28em);
  }

  dd {
    margin: 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .blurb {
    font-size: 0.92rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .social-icon:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  /* Three columns: date, then the two-line body, then the outcome/liked pair
     stacked and right-aligned — the same shape as the collection index's
     meta column. Links out to the entry's own page at /tried/<slug>. */
  .entry {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 0;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .entry:hover {
    background: var(--accent-soft);
  }

  .date {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.15s ease;
  }

  .entry:hover .date {
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    text-align: right;
    white-space: nowrap;
  }

  .tag {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
    transition: color 0.15s ease;
  }

  .entry:hover .tag {
    color: var(--accent);
  }

  .tag-liked {
    color: var(--muted);
  }

  .gallery {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem;
  }

  .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .caption {
    margin: 0.6rem 0 0;
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--faint);
    text-wrap: pretty;
  }

  .more {
    margin: 1.4rem 0 0;
  }

  .more a {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .more a:hover {
    color: var(--accent);
  }

  /* The one breakpoint, matching the collection index. */
  @media (max-width: 46rem) {
    .lede {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 11rem;
      order: -1;
      margin-bottom: 0.5rem;
    }

    .pair {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1rem 0;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1rem 0;
    }

    .tags {
      flex-direction: row;
      align-items: baseline;
      gap: 0.8rem;
      text-align: left;
    }

    /* No margin left to hang a numeral in once the shell goes full-width. */
    h2::before {
      display: none;
    }

    /* The term and its definition stack here, so a leader would run the
       full width and point at nothing. */
    dt::after {
      display: none;
    }
  }
</style>
