---
import { loadRegistry } from '../../tools/registry.mjs';
import { hasSnapshot, readSnapshot } from '../../tools/importer.mjs';
import Doc from '../layouts/Doc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { routeHref } from '../lib/paths';

const { site, pages } = await loadRegistry();

const KINDS = {
  local: 'written here',
  import: 'imported',
  embed: 'embedded',
  redirect: 'redirect',
};

const entries = await Promise.all(
  pages.map(async (page) => {
    const kind = page.type === 'local' ? 'local' : page.mode;

    let meta = '';
    if (page.type === 'external') {
      meta = new URL(page.url).host;
      if (page.mode === 'import' && hasSnapshot(page)) {
        const snapshot = await readSnapshot(page);
        if (snapshot.meta?.fetchedAt) meta = snapshot.meta.fetchedAt.slice(0, 10);
      }
    }

    return {
      href: routeHref(page.route),
      route: page.route,
      title: page.title,
      description: page.description,
      kind: KINDS[kind] ?? kind,
      meta,
      search: [page.title, page.description, page.route, ...page.tags].join(' ').toLowerCase(),
    };
  }),
);
---

<Doc title={site.title} siteTitle={site.title} description={site.description} chrome={false} wide>
  <header>
    <div class="masthead">
      <p class="eyebrow">Index</p>
      <ThemeToggle />
    </div>
    <h1>{site.title}</h1>
    <p class="standfirst">{site.description}</p>
  </header>

  <div class="controls">
    <input id="filter" type="search" placeholder="Filter" aria-label="Filter pages" autocomplete="off" />
    <span class="count" id="count">{entries.length}</span>
  </div>

  <ol class="index" id="index">
    {
      entries.map((entry) => (
        <li class="row" data-search={entry.search}>
          <a href={entry.href}>
            <span class="route">{entry.route}</span>
            <span class="body">
              <span class="title">{entry.title}</span>
              {entry.description && <span class="blurb">{entry.description}</span>}
            </span>
            <span class="meta">
              <span class="kind">{entry.kind}</span>
              {entry.meta && <span class="detail">{entry.meta}</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <p class="empty" id="empty" hidden>No page matches that.</p>
</Doc>

<script>
  const input = document.getElementById('filter') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#index .row'));
  const empty = document.getElementById('empty');
  const count = document.getElementById('count');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const row of rows) {
      const match = !q || (row.dataset.search ?? '').includes(q);
      row.hidden = !match;
      if (match) shown++;
    }
    if (empty) empty.hidden = shown !== 0;
    if (count) count.textContent = String(shown);
  });
</script>

<style>
  header {
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  h1 {
    margin: 0 0 .8rem;
  }

  .standfirst {
    margin: 0;
    max-width: var(--measure);
    font-size: 1.05rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .controls {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .7rem;
    border-bottom: 1px solid var(--border-strong);
  }

  #filter {
    flex: 1;
    min-width: 0;
    padding: 0;
    background: none;
    border: 0;
    color: var(--text);
    font-family: var(--mono);
    font-size: .78rem;
    letter-spacing: .02em;
  }

  #filter::placeholder {
    color: var(--faint);
  }

  #filter:focus {
    outline: none;
  }

  #filter:focus::placeholder {
    color: transparent;
  }

  .count {
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  .row a {
    display: grid;
    grid-template-columns: 13rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.4rem 0;
    text-decoration: none;
    transition: background-color .15s ease;
  }

  .row a:hover {
    /* Bleed the tint past the text column so the whole row reads as one target. */
    box-shadow: -1rem 0 0 var(--accent-soft), 1rem 0 0 var(--accent-soft);
    background: var(--accent-soft);
  }

  .route {
    font-family: var(--mono);
    font-size: .8rem;
    color: var(--muted);
    word-break: break-all;
    transition: color .15s ease;
  }

  .row a:hover .route {
    color: var(--accent);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: .3rem;
  }

  .title {
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.01em;
    text-wrap: balance;
  }

  .blurb {
    font-size: .92rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .3rem;
    text-align: right;
    white-space: nowrap;
  }

  .kind {
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .detail {
    font-family: var(--mono);
    font-size: .68rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    padding: 2.5rem 0;
    color: var(--muted);
    font-size: .95rem;
  }

  /* One breakpoint: the three-column row folds into a stack. */
  @media (max-width: 46rem) {
    .row a {
      grid-template-columns: 1fr;
      gap: .45rem;
      padding: 1.2rem 0;
    }

    .meta {
      flex-direction: row;
      align-items: baseline;
      gap: .8rem;
      text-align: left;
    }

    .row a:hover {
      box-shadow: -.75rem 0 0 var(--accent-soft), .75rem 0 0 var(--accent-soft);
    }
  }
</style>
