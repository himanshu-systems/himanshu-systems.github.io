---
import Doc from '../../layouts/Doc.astro';
import { loadRegistry } from '../../../tools/registry.mjs';
import { resolveImage, routeHref } from '../../lib/paths';
import { getBlogPosts, type BlogPost } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const { site } = await loadRegistry();

const hasContent = Boolean(post.content?.trim());
---

<Doc
  title={post.title}
  siteTitle={site.title}
  description={post.description}
  chrome={false}
  wide={false}
  prose={true}
>
  <p class="eyebrow"><a href={routeHref('/blog')}>&larr; Blog</a></p>

  <div class="meta">
    <span class="date">{post.date}</span>
    {post.readingTime && <span class="tag tag-liked">{post.readingTime}</span>}
  </div>

  <h1>{post.title}</h1>

  {post.tags.length > 0 && <p class="domains">{post.tags.join(' · ')}</p>}

  {
    post.image && (
      <img
        class="cover"
        src={resolveImage(post.image.src)}
        alt={post.image.alt}
        loading="lazy"
        decoding="async"
      />
    )
  }

  {
    hasContent ? (
      <div class="prose" set:html={post.content} />
    ) : (
      <div class="prose">
        <p>{post.description}</p>
      </div>
    )
  }
</Doc>

<style>
  .eyebrow {
    margin: 0 0 2rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow a {
    color: var(--faint);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .eyebrow a:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .date {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .tag {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .tag-liked {
    color: var(--muted);
  }

  h1 {
    margin: 0 0 0.6rem;
    font-weight: 500;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .domains {
    margin: 0 0 2.5rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 2.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  /* :global() because the prose container uses set:html from Quill */
  .prose :global(p) {
    margin: 0 0 1.1em;
    color: var(--muted);
    text-wrap: pretty;
  }

  .prose :global(p:first-child) {
    font-size: 1.05rem;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(a) {
    color: inherit;
    text-decoration-color: var(--border-strong);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1em;
    padding-left: 1.2rem;
    color: var(--muted);
  }

  .prose :global(li) {
    margin: 0.35rem 0;
  }

  .prose :global(h2),
  .prose :global(h3) {
    color: var(--text);
    margin: 1.5em 0 0.6em;
    font-weight: 500;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-top: 3rem;
  }

  .prose :global(h3) {
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 2.25rem;
  }

  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--border-strong);
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--accent-soft);
    padding: 0.15em 0.4em;
    border-radius: 3px;
  }

  .prose :global(pre) {
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.7;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 4px;
    margin: 1.5rem 0;
  }
</style>
