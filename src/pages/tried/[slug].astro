---
import Doc from '../../layouts/Doc.astro';
import { loadRegistry } from '../../../tools/registry.mjs';
import { resolveImage, routeHref } from '../../lib/paths';
import { getTriedRows, type TriedRow } from '../../lib/tried';

export async function getStaticPaths() {
  const rows = await getTriedRows();
  return rows.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: TriedRow };
const { site } = await loadRegistry();

// description is rich HTML from Quill in /admin. No description yet? The
// one-line note is what shows instead, as plain text.
const hasDescription = Boolean(entry.description?.trim());
---

<Doc title={entry.title} siteTitle={site.title} description={entry.note} chrome={false}>
  <p class="eyebrow"><a href={routeHref('/tried')}>&larr; Tried</a></p>

  <div class="meta">
    <span class="date">{entry.date}</span>
    {entry.outcome && <span class="tag">{entry.outcome}</span>}
    {entry.liked && <span class="tag tag-liked">{entry.liked}</span>}
  </div>

  <h1>{entry.title}</h1>

  {entry.tags.length > 0 && <p class="domains">{entry.tags.join(' · ')}</p>}

  {
    entry.image && (
      <img class="cover" src={resolveImage(entry.image.src)} alt={entry.image.alt} loading="lazy" decoding="async" />
    )
  }

  {
    hasDescription ? (
      <div class="prose" set:html={entry.description} />
    ) : (
      <div class="prose">
        <p>{entry.note}</p>
      </div>
    )
  }
</Doc>

<style>
  .eyebrow {
    margin: 0 0 2rem;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .eyebrow a {
    color: var(--faint);
    text-decoration: none;
    transition: color .15s ease;
  }

  .eyebrow a:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: .8rem;
  }

  .date {
    font-family: var(--mono);
    font-size: .78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .tag {
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .tag-liked {
    color: var(--muted);
  }

  h1 {
    margin: 0 0 .6rem;
  }

  .domains {
    margin: 0 0 2.5rem;
    font-family: var(--mono);
    font-size: .74rem;
    letter-spacing: .04em;
    color: var(--faint);
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 2.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  /* :global() because the description branch is set:html from Quill --
     raw content Astro never compiles, so it never gets the scoping
     attribute a plain selector here would need to match. */
  .prose :global(p) {
    margin: 0 0 1.1em;
    color: var(--muted);
    text-wrap: pretty;
  }

  .prose :global(p:first-child) {
    font-size: 1.05rem;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(a) {
    color: inherit;
    text-decoration-color: var(--border-strong);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1em;
    padding-left: 1.2rem;
    color: var(--muted);
  }

  .prose :global(h2),
  .prose :global(h3) {
    color: var(--text);
    margin: 1.5em 0 .6em;
  }
</style>
