---
import Doc from '../layouts/Doc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { loadRegistry } from '../../tools/registry.mjs';

const { site } = await loadRegistry();

/* ────────────────────────────────────────────────────────────────────────────
 * EDIT EVERYTHING IN THIS BLOCK. Nothing below it needs to change.
 *
 * The placeholder prose describes what to write rather than inventing a bio.
 * Replace it before you show this page to anyone. Delete any section you do
 * not want by emptying its array — the heading disappears with it.
 * ──────────────────────────────────────────────────────────────────────────── */
const me = {
  name: 'Himanshu Chavda',

  /* One line, under your name. What you do, in plain words. */
  role: 'Describe what you do in one short line.',

  /* Two or three sentences. What you care about, what you are working toward,
     how you got here. Keep it plain — this is the part people actually read. */
  intro:
    'Write two or three sentences about yourself here. What you build, what ' +
    'you are curious about, and what you are working toward. Plain language ' +
    'beats a list of adjectives.',

  /* Optional. One line about what is on your desk right now. Empty string hides it. */
  now: 'What you are working on at the moment.',

  /* Left column is the area, right column is the detail. */
  doing: [
    { label: 'building', detail: 'The kind of things you make, and who for.' },
    { label: 'tools', detail: 'The languages and tools you reach for first.' },
    { label: 'learning', detail: 'What you are teaching yourself right now.' },
  ],

  /* Set href to null for anything that has no link yet. */
  work: [
    {
      year: '2026',
      title: 'HTML DOCS TO Learn',
      blurb: 'A single GitHub Pages site that serves both hand-written pages and imported HTML, driven by one registry file.',
      href: 'https://github.com/himanshu-systems/HTML-DOCS-TO-Learn',
    },
    {
      year: '20XX',
      title: 'Another project',
      blurb: 'One sentence on what it does and why you built it.',
      href: null,
    },
  ],

  /* Remove the email line if you would rather not have it scraped. */
  elsewhere: [
    { label: 'github', text: '@himanshu-systems', href: 'https://github.com/himanshu-systems' },
    { label: 'email', text: 'himanshuchavdacodes@gmail.com', href: 'mailto:himanshuchavdacodes@gmail.com' },
  ],
};
/* ──────────────────────────────────────────────────────────────────────────── */
---

<Doc
  title={me.name}
  siteTitle={site.title}
  description={`${me.name} — ${me.role}`}
  wide
>
  <header>
    <div class="masthead">
      <p class="eyebrow">{me.name}</p>
      <ThemeToggle />
    </div>
    <h1>{me.role}</h1>
    <p class="intro">{me.intro}</p>
    {me.now && (
      <p class="now">
        <span class="now-label">Now</span>
        {me.now}
      </p>
    )}
  </header>

  {
    me.doing.length > 0 && (
      <section>
        <h2>What I do</h2>
        <dl class="rows">
          {me.doing.map((item) => (
            <div class="row">
              <dt>{item.label}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    me.work.length > 0 && (
      <section>
        <h2>Selected work</h2>
        <ol class="rows work">
          {me.work.map((item) => {
            const inner = (
              <>
                <span class="year">{item.year}</span>
                <span class="body">
                  <span class="title">{item.title}</span>
                  <span class="blurb">{item.blurb}</span>
                </span>
              </>
            );
            return (
              <li class="row">
                {item.href ? (
                  <a href={item.href} rel="noopener noreferrer">
                    {inner}
                  </a>
                ) : (
                  <div class="static">{inner}</div>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  {
    me.elsewhere.length > 0 && (
      <section>
        <h2>Elsewhere</h2>
        <ul class="rows links">
          {me.elsewhere.map((item) => (
            <li class="row">
              <a href={item.href} rel="noopener noreferrer">
                <span class="label">{item.label}</span>
                <span class="text">{item.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Doc>

<style>
  header {
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  h1 {
    margin: 0 0 1.2rem;
    max-width: var(--measure);
  }

  .intro {
    margin: 0;
    max-width: var(--measure);
    font-size: 1.05rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .now {
    margin: 1.6rem 0 0;
    max-width: var(--measure);
    font-size: .95rem;
    color: var(--muted);
  }

  .now-label {
    display: inline-block;
    margin-right: .6rem;
    font-family: var(--mono);
    font-size: .62rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    vertical-align: .1em;
  }

  /* Section headings borrow the index's mono label, not the prose h2. */
  section {
    margin-top: clamp(2.75rem, 6vw, 4rem);
  }

  h2 {
    margin: 0;
    padding-bottom: .7rem;
    border-bottom: 1px solid var(--border-strong);
    font-family: var(--mono);
    font-size: .7rem;
    font-weight: 400;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  /* One grid shape for all three sections, so the columns line up down the page. */
  .row > a,
  .row > .static,
  .rows > .row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 0;
    text-decoration: none;
  }

  .row > a {
    transition: background-color .15s ease;
  }

  .row > a:hover {
    /* Same bleed as the index rows: the whole row is the target. */
    background: var(--accent-soft);
    box-shadow: -1rem 0 0 var(--accent-soft), 1rem 0 0 var(--accent-soft);
  }

  dt,
  .year,
  .label {
    font-family: var(--mono);
    font-size: .76rem;
    letter-spacing: .02em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color .15s ease;
  }

  .row > a:hover .year,
  .row > a:hover .label {
    color: var(--accent);
  }

  dd {
    margin: 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: .3rem;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.01em;
    color: var(--text);
  }

  .blurb {
    font-size: .92rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .links .text {
    color: var(--text);
    font-size: .98rem;
    word-break: break-word;
  }

  /* The one breakpoint, matching the index: two columns fold to a stack. */
  @media (max-width: 46rem) {
    .row > a,
    .row > .static,
    .rows > .row {
      grid-template-columns: 1fr;
      gap: .4rem;
      padding: 1rem 0;
    }

    .row > a:hover {
      box-shadow: -.75rem 0 0 var(--accent-soft), .75rem 0 0 var(--accent-soft);
    }
  }
</style>
