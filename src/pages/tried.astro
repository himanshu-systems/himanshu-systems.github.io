---
import Doc from '../layouts/Doc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { loadRegistry } from '../../tools/registry.mjs';
import { home, collection } from '../lib/paths';
import { getTriedRows } from '../lib/tried';

const { site } = await loadRegistry();
const entries = await getTriedRows();
---

<Doc
  title="Tried"
  siteTitle={site.title}
  description="Things I've tried, what happened, and whether I'd do it again."
  chrome={false}
  wide
>
  <header>
    <div class="masthead">
      <p class="eyebrow">Tried</p>
      <nav>
        <a href={home}>About</a>
        <a href={collection}>Pages</a>
        <ThemeToggle />
      </nav>
    </div>
    <h1>Things I've tried</h1>
    <p class="standfirst">Worked, failed, mixed, still going — a running log, newest first. Click one to read the full entry.</p>
  </header>

  <div class="controls">
    <input id="filter" type="search" placeholder="Filter by title, tag, or outcome" aria-label="Filter entries" autocomplete="off" />
    <span class="count" id="count">{entries.length}</span>
  </div>

  <ol class="rows" id="index">
    {
      entries.map((item) => (
        <li class="row" data-search={item.search}>
          <a class="entry" href={item.href}>
            <span class="date">{item.date}</span>
            <span class="body">
              <span class="title">{item.title}</span>
              {item.note && <span class="blurb">{item.note}</span>}
              {item.tags.length > 0 && <span class="domains">{item.tags.join(' · ')}</span>}
            </span>
            <span class="tags">
              {item.outcome && <span class="tag">{item.outcome}</span>}
              {item.liked && <span class="tag tag-liked">{item.liked}</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <p class="empty" id="empty" hidden>Nothing matches that.</p>
</Doc>

<script>
  import { matchesQuery } from '../lib/filter';

  const input = document.getElementById('filter') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#index .row'));
  const empty = document.getElementById('empty');
  const count = document.getElementById('count');

  input?.addEventListener('input', () => {
    let shown = 0;
    for (const row of rows) {
      const match = matchesQuery(row.dataset.search ?? '', input.value);
      row.hidden = !match;
      if (match) shown++;
    }
    if (empty) empty.hidden = shown !== 0;
    if (count) count.textContent = String(shown);
  });
</script>

<style>
  header {
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  nav a {
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .04em;
    color: var(--muted);
    text-decoration: none;
    transition: color .15s ease;
  }

  nav a:hover {
    color: var(--accent);
  }

  h1 {
    margin: 0 0 .8rem;
  }

  .standfirst {
    margin: 0;
    max-width: var(--measure);
    font-size: 1.05rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .controls {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .7rem;
    border-bottom: 1px solid var(--border-strong);
  }

  #filter {
    flex: 1;
    min-width: 0;
    padding: 0;
    background: none;
    border: 0;
    color: var(--text);
    font-family: var(--mono);
    font-size: .78rem;
    letter-spacing: .02em;
  }

  #filter::placeholder {
    color: var(--faint);
  }

  #filter:focus {
    outline: none;
  }

  #filter:focus::placeholder {
    color: transparent;
  }

  .count {
    font-family: var(--mono);
    font-size: .7rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  /* Same shape as the about page's Tried teaser: date | body | outcome+liked.
     Links to the entry's own page at /tried/<slug>. */
  .entry {
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.25rem 0;
    text-decoration: none;
    transition: background-color .15s ease;
  }

  .entry:hover {
    background: var(--accent-soft);
    box-shadow: -1rem 0 0 var(--accent-soft), 1rem 0 0 var(--accent-soft);
  }

  .date {
    font-family: var(--mono);
    font-size: .76rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color .15s ease;
  }

  .entry:hover .date {
    color: var(--accent);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: .3rem;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.01em;
    color: var(--text);
  }

  .blurb {
    font-size: .92rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .domains {
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .04em;
    color: var(--faint);
  }

  .tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .3rem;
    text-align: right;
    white-space: nowrap;
  }

  .tag {
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--faint);
    transition: color .15s ease;
  }

  .entry:hover .tag {
    color: var(--accent);
  }

  .tag-liked {
    color: var(--muted);
  }

  .empty {
    padding: 2.5rem 0;
    color: var(--muted);
    font-size: .95rem;
  }

  /* The one breakpoint, matching every other listing on the site. */
  @media (max-width: 46rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: .4rem;
      padding: 1rem 0;
    }

    .tags {
      flex-direction: row;
      align-items: baseline;
      gap: .8rem;
      text-align: left;
    }

    .entry:hover {
      box-shadow: -.75rem 0 0 var(--accent-soft), .75rem 0 0 var(--accent-soft);
    }
  }
</style>
