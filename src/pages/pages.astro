---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { loadRegistry, STATIC_DIR } from '../../tools/registry.mjs';
import { hasSnapshot, readSnapshot } from '../../tools/importer.mjs';
import Doc from '../layouts/Doc.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { routeHref, home, asset } from '../lib/paths';

import '../styles/masthead.css';
import '../styles/listing.css';

const { site, pages } = await loadRegistry();

const KINDS = {
  local: 'written here',
  import: 'imported',
  embed: 'embedded',
  redirect: 'redirect',
};

const entries = await Promise.all(
  pages.map(async (page) => {
    const kind = page.type === 'local' ? 'local' : page.mode;

    let meta = '';
    if (page.type === 'external') {
      meta = new URL(page.url).host;
      if (page.mode === 'import' && hasSnapshot(page)) {
        const snapshot = await readSnapshot(page);
        if (snapshot.meta?.fetchedAt) meta = snapshot.meta.fetchedAt.slice(0, 10);
      }
    }

    // Thumbnails live in static/ (public/ is wiped and regenerated by
    // prepare.mjs on every build), and are committed by `npm run shots`. A page
    // added since the last run simply has none, so check the file rather than
    // assume one exists -- otherwise the listing wires up a panel that 404s.
    //
    // Resolved from STATIC_DIR, not `new URL('../../static', import.meta.url)`:
    // Vite bundles this component during `astro build`, so import.meta.url no
    // longer points at src/pages/ and the relative walk lands somewhere else.
    const slug = page.route.replace(/^\//, '').replace(/\//g, '-') || 'index';
    const preview = existsSync(join(STATIC_DIR, 'previews', `${slug}.jpg`))
      ? asset(`previews/${slug}.jpg`)
      : null;

    return {
      href: routeHref(page.route),
      preview,
      route: page.route,
      title: page.title,
      description: page.description,
      kind: KINDS[kind] ?? kind,
      meta,
      search: [page.title, page.description, page.route, ...page.tags].join(' ').toLowerCase(),
    };
  }),
);
---

<Doc title="Pages" siteTitle={site.title} description={site.description} chrome={false} wide>
  <header>
    <div class="masthead">
      <p class="eyebrow">Pages</p>
      <nav>
        <a href={home}>About</a>
        <a href={routeHref('/tried')}>Tried</a>
        <a href={routeHref('/blog')}>Blog</a>
        <ThemeToggle />
      </nav>
    </div>
    <h1>{site.title}</h1>
    <p class="standfirst">{site.description}</p>
  </header>

  <div class="controls">
    <input id="filter" type="search" placeholder="Filter" aria-label="Filter pages" autocomplete="off" />
    <span class="count" id="count">{entries.length}</span>
  </div>

  <ol class="rows" id="index">
    {
      entries.map((entry) => (
        <li class="row" data-search={entry.search}>
          <a href={entry.href} data-preview={entry.preview ?? undefined} data-preview-label={entry.preview ? entry.route : undefined}>
            <span class="route">{entry.route}</span>
            <span class="body">
              <span class="title">{entry.title}</span>
              {entry.description && <span class="blurb">{entry.description}</span>}
            </span>
            <span class="meta">
              <span class="kind">{entry.kind}</span>
              {entry.meta && <span class="detail">{entry.meta}</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <p class="empty" id="empty" hidden>No page matches that.</p>
</Doc>

<script>
  import { initFilter } from '../lib/filterUI';
  import { initLinkPreview } from '../lib/linkPreview';
  initFilter();
  initLinkPreview();
</script>

<style is:global>
  /* The panel is built by linkPreview.ts with document.createElement and
     appended to <body>, so Astro's scoped CSS never reaches it -- these have to
     be global. Geometry here must stay in step with W/H in that module. */
  .link-preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    width: 240px;
    background: var(--surface);
    /* Hairline, no shadow: a drop shadow would be the one card-like thing on a
       site whose whole listing language is 1px rules. --surface is opaque, so
       the border alone is enough separation from the text underneath. */
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity .16s ease, transform .16s ease;
  }

  .link-preview.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .link-preview img {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: cover;
    object-position: top center;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .link-preview__cap {
    display: block;
    padding: .4rem .55rem;
    font-family: var(--mono);
    font-size: .62rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Reduced motion keeps the panel -- it carries information -- and drops only
     the movement, so nothing slides or lifts. */
  @media (prefers-reduced-motion: reduce) {
    .link-preview {
      transform: none;
      transition: opacity .01ms;
    }

    .link-preview.is-open {
      transform: none;
    }
  }

  @media print {
    .link-preview {
      display: none;
    }
  }
</style>

<style>

  .row a {
    display: grid;
    grid-template-columns: 13rem 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.4rem 0;
    text-decoration: none;
    transition: background-color .15s ease;
  }

  .row a:hover {
    /* Bleed the tint past the text column so the whole row reads as one target. */
    box-shadow: -1rem 0 0 var(--accent-soft), 1rem 0 0 var(--accent-soft);
    background: var(--accent-soft);
  }

  .route {
    font-family: var(--mono);
    font-size: .8rem;
    color: var(--muted);
    word-break: break-all;
    transition: color .15s ease;
  }

  .row a:hover .route {
    color: var(--accent);
  }

  .title {
    font-size: 1.12rem;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: .3rem;
    text-align: right;
    white-space: nowrap;
  }

  .kind {
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .detail {
    font-family: var(--mono);
    font-size: .68rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  /* One breakpoint: the three-column row folds into a stack. */
  @media (max-width: 46rem) {
    .row a {
      grid-template-columns: 1fr;
      gap: .45rem;
      padding: 1.2rem 0;
    }

    .meta {
      flex-direction: row;
      align-items: baseline;
      gap: .8rem;
      text-align: left;
    }

    .row a:hover {
      box-shadow: -.75rem 0 0 var(--accent-soft), .75rem 0 0 var(--accent-soft);
    }
  }
</style>
