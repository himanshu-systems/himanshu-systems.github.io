---
/**
 * Wraps an image in Canvas UI's Ripple: press it and water rings spread out,
 * bending the photo like a pond surface.
 *
 * The real <img> stays in the DOM with its alt text and normal sizing -- the
 * WebGL canvas sits on top, transparent at rest, and only paints while rings
 * are alive. So with JS off, WebGL unavailable, or reduced motion on, this is
 * exactly the photo it always was.
 *
 * Uses ripple.ts's media mode: the image is uploaded straight to the GPU
 * rather than going through the experimental html-in-canvas API the upstream
 * component requires, so the refraction works in every browser.
 */
import { resolveImage } from '../lib/paths';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /**
   * A tiny blurred data URI painted behind the photo, so the framed box is
   * never empty while the real file is in flight. Generated by tools/images.mjs
   * into tools/lqip.json; ~0.5 KB, small enough to inline.
   */
  placeholder?: string;
  class?: string;
  /** How far the waves bend the photo, in CSS pixels. */
  refraction?: number;
  /** Distance between crests, in CSS pixels. */
  wavelength?: number;
}

const {
  src,
  alt,
  width = 640,
  height = 800,
  placeholder = '',
  class: className,
  refraction = 14,
  wavelength = 34,
} = Astro.props;
---

<div
  class="ripple-photo"
  data-refraction={refraction}
  data-wavelength={wavelength}
>
  <img
    class:list={['ripple-photo-img', className]}
    src={resolveImage(src)}
    alt={alt}
    width={width}
    height={height}
    {...(placeholder
      ? { style: `background-image:url(${placeholder});background-size:cover;background-position:center` }
      : {})}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <canvas class="ripple-photo-output" aria-hidden="true"></canvas>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>('.ripple-photo');
  if (roots.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          observer.unobserve(entry.target);
          initRipple(entry.target as HTMLElement);
        }
      });
    });
    roots.forEach((root) => observer.observe(root));
  }

  let rippleModule: any = null;

  async function initRipple(root: HTMLElement) {
    if (!rippleModule) {
      try {
        rippleModule = await import('../lib/ripple');
      } catch (e) {
        console.error('Failed to load ripple effect', e);
        return;
      }
    }
    const { createRipple } = rippleModule;

    const image = root.querySelector<HTMLImageElement>('img.ripple-photo-img');
    const output = root.querySelector<HTMLCanvasElement>('canvas.ripple-photo-output');
    if (!image || !output) return;

    const instance = createRipple(
      { content: root, output, media: image },
      {
        /*
         * Far under the docs demo, which ripples a whole page. This is a
         * ~206px portrait, so the same numbers smear a face instead of
         * reading as water: at refraction 26 the first 250ms was a radial
         * blur with rainbow fringing through the hair.
         *
         * Dialled to a quick, shallow disturbance that clears fast -- the
         * ring should cross a small photo and be gone, not sit on it.
         */
        refraction: Number(root.dataset.refraction) || 14,
        wavelength: Number(root.dataset.wavelength) || 34,
        amplitude: 0.45,
        // Faster front + heavier decay: the strong phase passes over the
        // face in a few frames rather than lingering on it.
        speed: 0.6,
        rings: 2,
        decay: 1.7,
        // Near zero. Dispersion is what fringed the hair with colour.
        dispersion: 0.05,
        shine: 0.3,
        trigger: 'click',
        interval: 0,
      },
    );

    if (!instance) return;

    // Nudge the first upload once the image has actually decoded, so the very
    // first click ripples the photo rather than an empty texture.
    if (image.complete && image.naturalWidth > 0) instance.refresh();
    else image.addEventListener('load', () => instance.refresh(), { once: true });
  }
</script>

<style>
  /* Fills whatever box the page gives it, so the caller owns the framing
     (aspect ratio, border, radius) and this component owns the effect. */
  .ripple-photo {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    /* The photo is the hit target; the canvas over it never takes a click. */
    cursor: pointer;
    touch-action: manipulation;
  }

  .ripple-photo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ripple-photo-output {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
