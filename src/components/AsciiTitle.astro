---
/**
 * Runs Canvas UI's ASCII Sweep over a title: a band of glowing characters
 * crosses the text once, growing glyphs on the exact lines it passes over.
 *
 * The upstream effect sweeps *between* two panels. Here both panels hold the
 * same title, so there is nothing to swap -- what's left is the band itself
 * reading as a one-shot reveal over the words.
 *
 * PROGRESSIVE ENHANCEMENT -- the important property of this component.
 * The server renders exactly one thing: the heading, in normal flow, styled by
 * the page. It is readable at first paint, with no JavaScript, and stays
 * readable if the module 404s, if WebGL is unavailable, or if the visitor never
 * scrolls to it. Everything the effect needs -- the second panel, the source
 * canvases, the output canvas -- is built here in the browser, and only once
 * the module has actually loaded.
 *
 * It used to render the heading inside <canvas class="ascii-source">, because
 * that is the shape the html-in-canvas path wants. But a canvas never lays out
 * its fallback children, so the headline was invisible from first paint until
 * the module downloaded, parsed and ran -- on a slow connection, a blank space
 * where the largest text on the page should be.
 *
 * Layout: the flow panel sizes the wrapper the way the bare heading always did,
 * so nothing below it moves when the effect attaches. The overlay panel and the
 * output canvas are absolutely positioned on top. That is why this doesn't use
 * the upstream React wrapper, which absolutely positions both panels and needs
 * a fixed height -- wrong for a heading whose height depends on where it wraps.
 */
interface Props {
  /** Seconds the band takes to cross. */
  duration?: number;
  /** Delay before the reveal fires, in ms. */
  delay?: number;
  /** Sweep again whenever the title is clicked. */
  replayOnClick?: boolean;
  class?: string;
}

const {
  duration = 2.4,
  delay = 260,
  replayOnClick = true,
  class: className,
} = Astro.props;
---

<div
  class:list={['ascii-title', className]}
  data-duration={duration}
  data-delay={delay}
  data-replay={replayOnClick ? 'true' : 'false'}
>
  {/* The only server-rendered node: the real heading, in flow and visible. */}
  <div class="ascii-panel ascii-panel--flow" data-content="0">
    <slot />
  </div>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>('.ascii-title');
  if (roots.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          observer.unobserve(entry.target);
          initAscii(entry.target as HTMLElement);
        }
      });
    });
    roots.forEach((root) => observer.observe(root));
  }

  let asciiSweepModule: any = null;

  async function initAscii(root: HTMLElement) {
    if (!asciiSweepModule) {
      try {
        asciiSweepModule = await import('../lib/asciiSweep');
      } catch (e) {
        // The heading is already on screen and staying there; the reveal is
        // the only thing lost.
        console.error('Failed to load ASCII sweep', e);
        return;
      }
    }
    const { createAsciiSweep, supportsHtmlInCanvas } = asciiSweepModule;

    const flow = root.querySelector<HTMLElement>('[data-content="0"]');
    if (!flow) return;

    const nativeCapture = supportsHtmlInCanvas();

    // The second panel is a copy of the first, so the two captures are
    // identical by construction. Cloning beats rendering it server-side: no
    // duplicate heading in the document for a crawler or a screen reader to
    // meet before the script has had a chance to mark it aria-hidden, and
    // nothing to keep in sync if the slotted markup changes.
    const overlay = flow.cloneNode(true) as HTMLElement;
    overlay.classList.remove('ascii-panel--flow');
    overlay.classList.add('ascii-panel--overlay');
    overlay.dataset.content = '1';
    overlay.setAttribute('aria-hidden', 'true');

    const output = document.createElement('canvas');
    output.className = 'ascii-output';
    output.setAttribute('aria-hidden', 'true');

    // Source canvases exist to satisfy the engine's slot shape. Under
    // html-in-canvas they must be in the document and must contain the panels,
    // because that is what gets rasterised. Otherwise the fallback rasteriser
    // reads the live DOM and these stay detached and unused.
    const sources = [0, 1].map((slot) => {
      const c = document.createElement('canvas');
      c.className = 'ascii-source';
      c.setAttribute('layoutsubtree', 'true');
      c.dataset.slot = String(slot);
      return c;
    });

    if (nativeCapture) {
      root.append(sources[0], sources[1]);
      sources[0].append(flow);
      sources[1].append(overlay);
      sources[1].setAttribute('aria-hidden', 'true');
    } else {
      root.append(overlay);
    }
    root.append(output);

    const instance = createAsciiSweep(
      {
        slots: [
          { source: sources[0], content: flow },
          { source: sources[1], content: overlay },
        ],
        output,
      },
      {
        duration: Number(root.dataset.duration) || 2.4,
        // Gentler than upstream's fixed cubic. At 3 the band was 58% across
        // after a quarter of the duration, so it read as a flick no matter
        // what duration said; 1.5 spreads the travel over the whole run.
        easeExponent: 1.5,
        // The site's one accent, read live so it tracks the theme toggle.
        color: getComputedStyle(root).getPropertyValue('--accent').trim() || '#0b7a6e',
        // Dialled well below the docs demo: this sits behind real reading text,
        // not a effects showcase. No tearing, far less flicker and aberration.
        displace: 0,
        aberration: 1.5,
        flicker: 0.18,
        glow: 1.1,
        turbulence: 0.35,
        band: 0.22,
        scale: 2,
      },
    );

    // No WebGL, or the engine declined for any other reason: put the DOM back
    // the way the server sent it rather than leaving an inert duplicate of the
    // heading stacked on the real one.
    if (!instance) {
      if (nativeCapture) {
        root.prepend(flow);
        sources.forEach((c) => c.remove());
      }
      overlay.remove();
      output.remove();
      return;
    }

    // Only now is the effect definitely running, so only now does the wrapper
    // take responsibility for painting the title.
    root.classList.add('is-live');

    // Fires once the fonts have settled, so the band traces the real serif
    // shapes rather than whatever fallback face was up at first paint.
    const fire = () => {
      instance.capture();
      instance.sweep(instance.current() === 0 ? 1 : 0);
    };

    const ready = document.fonts?.ready ?? Promise.resolve();
    ready.then(() => {
      instance.capture();
      window.setTimeout(fire, Number(root.dataset.delay) || 0);
    });

    if (root.dataset.replay === 'true') {
      root.style.cursor = 'pointer';
      root.addEventListener('click', fire);
    }
  }
</script>

<style>
  .ascii-title {
    position: relative;
  }

  /* Only laid out under html-in-canvas, and only ever inserted by the script. */
  .ascii-source {
    display: block;
    width: 100%;
  }

  .ascii-source[data-slot='1'] {
    position: absolute;
    inset: 0;
  }

  /* flow-root on both panels is load-bearing. The slotted heading carries a
     bottom margin; without a block formatting context that margin collapses
     out of the in-flow panel but is still inside the overlay panel's inset:0
     box. The two captures then have different heights, the shader samples both
     with the same UVs, and the title ghosts against a vertically offset copy
     of itself. Containing the margin makes both boxes identical. */
  .ascii-panel {
    display: flow-root;
  }

  .ascii-panel--flow {
    position: relative;
  }

  .ascii-panel--overlay {
    position: absolute;
    inset: 0;
  }

  .ascii-output {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  /* The reveal is decoration. Under reduced motion the engine snaps the sweep
     to its end on the first frame, so the title just appears, unchanged. */
</style>
