---
/**
 * Deliberately not the official brand marks -- those come in five different
 * colours (GitHub black, LinkedIn blue, Instagram's gradient...), which
 * would break the one-accent rule everywhere else on the site. These are
 * plain currentColor outlines instead, so a hover just recolours like every
 * other link. Add a case here for any new label; falls back to a generic
 * link glyph for anything unrecognised.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
const key = label.trim().toLowerCase();
---

<svg
  class="social-icon-svg"
  viewBox="0 0 24 24"
  width="1.15em"
  height="1.15em"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    key === 'github' && (
      <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 3.5 5.4 3.8 5.4 3.8a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 10.2c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V22" />
    )
  }

  {
    (key === 'email' || key === 'mail') && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </>
    )
  }

  {
    (key === 'twitter' || key === 'x') && <path d="M4 4l16 16M20 4L4 20" />
  }

  {
    key === 'linkedin' && (
      <>
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
        <rect x="2" y="9" width="4" height="12" />
        <circle cx="4" cy="4" r="2" />
      </>
    )
  }

  {
    key === 'instagram' && (
      <>
        <rect x="2" y="2" width="20" height="20" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }

  {
    !['github', 'email', 'mail', 'twitter', 'x', 'linkedin', 'instagram'].includes(key) && (
      <>
        <path d="M10 14a4 4 0 0 0 6 0l3-3a4 4 0 0 0-6-6l-1.5 1.5" />
        <path d="M14 10a4 4 0 0 0-6 0l-3 3a4 4 0 0 0 6 6l1.5-1.5" />
      </>
    )
  }
</svg>
