---
/**
 * The one deliberate illustration on an otherwise type-only site. No box
 * this time -- position: fixed, no border, no background, so it genuinely
 * floats over whatever page is behind it rather than sitting in its own
 * panel. Rendered from Doc.astro, so it's on every page that uses that
 * layout, not just the about page -- except /admin, which opts out.
 *
 * pointer-events: none on the wrapper, auto only on the canvas itself, so
 * the transparent space around the wireframe never blocks a click or a
 * scroll on whatever's underneath it.
 */
---

<div class="floating-shape" aria-hidden="true">
  <canvas id="floating-canvas"></canvas>
</div>

<script>
  const container = document.querySelector('.floating-shape') as HTMLElement | null;
  const canvas = document.getElementById('floating-canvas') as HTMLCanvasElement | null;
  if (!container || !canvas) throw new Error('FloatingShape: expected container and canvas in the DOM');

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      observer.disconnect();
      init();
    }
  });
  observer.observe(container);

  async function init() {
    let three;
    try {
      three = await import('three');
    } catch (e) {
      console.error('Failed to load Three.js', e);
      return;
    }
    const {
      Scene,
      PerspectiveCamera,
      WebGLRenderer,
      IcosahedronGeometry,
      WireframeGeometry,
      LineBasicMaterial,
      LineSegments,
      Color,
    } = three;

    function accentColor(): number {
      const value = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
      return new Color(value || '#0b7a6e').getHex();
    }

    const scene = new Scene();
    const camera = new PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.z = 4.4;

    const renderer = new WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const geometry = new IcosahedronGeometry(1.35, 1);
    const wireframe = new WireframeGeometry(geometry);
    const material = new LineBasicMaterial({ color: accentColor(), transparent: true, opacity: 0.9 });
    const shape = new LineSegments(wireframe, material);
    shape.rotation.set(0.3, 0.4, 0);
    scene.add(shape);

    function resize() {
      const { width, height } = container!.getBoundingClientRect();
      if (width === 0 || height === 0) return;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(resize).observe(container!);
    resize();

    // Re-tint immediately if the theme toggle changes data-theme while this
    // page is open, rather than waiting for the next reload.
    new MutationObserver(() => material.color.setHex(accentColor())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    // Idle drift, skipped entirely under reduced motion -- what's left is
    // purely the momentum from a visitor's own drag, not ambient autoplay.
    let velY = reduceMotion ? 0 : 0.0016;
    let velX = reduceMotion ? 0 : 0.0012;

    canvas!.style.cursor = 'grab';
    canvas!.style.touchAction = 'none';

    canvas!.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas!.style.cursor = 'grabbing';
      canvas!.setPointerCapture(e.pointerId);
    });

    canvas!.addEventListener('pointerup', () => {
      dragging = false;
      canvas!.style.cursor = 'grab';
    });

    canvas!.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      shape.rotation.y += dx * 0.008;
      shape.rotation.x += dy * 0.008;
      velY = dx * 0.0006;
      velX = dy * 0.0006;
      lastX = e.clientX;
      lastY = e.clientY;
    });

    let t = 0;
    function animate() {
      requestAnimationFrame(animate);

      if (!dragging) {
        shape.rotation.y += velY;
        shape.rotation.x += velX;
        velY *= 0.985;
        velX *= 0.985;

        if (!reduceMotion) {
          shape.rotation.y += 0.0013;
          t += 0.01;
          shape.position.y = Math.sin(t) * 0.15;
        }
      }

      renderer.render(scene, camera);
    }
    animate();
  }
</script>

<style>
  .floating-shape {
    position: fixed;
    right: clamp(1rem, 4vw, 2.5rem);
    bottom: clamp(1rem, 4vw, 2.5rem);
    width: 9rem;
    height: 9rem;
    z-index: 40;
    pointer-events: none;
  }

  #floating-canvas {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }

  /* Out of the way on narrow screens -- there's no free corner left once
     content is a single column, and the drag interaction competes with
     scrolling on touch. */
  @media (max-width: 30rem) {
    .floating-shape {
      display: none;
    }
  }

  @media print {
    .floating-shape {
      display: none;
    }
  }
</style>
