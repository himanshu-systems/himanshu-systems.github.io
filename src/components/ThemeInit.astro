---
/**
 * Belongs in <head>, before any painting: stamps the saved theme choice on
 * <html> so the page never flashes the wrong palette. No stamp means "system",
 * which leaves prefers-color-scheme in charge.
 */
---

<script is:inline>
  try {
    const saved = localStorage.getItem('theme');
    if (saved === 'light' || saved === 'dark') {
      document.documentElement.setAttribute('data-theme', saved);
    }
  } catch {
    /* private mode or blocked storage: fall back to system */
  }
</script>
