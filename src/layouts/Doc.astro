---
import Chrome from '../components/Chrome.astro';
import ThemeInit from '../components/ThemeInit.astro';
import { asset } from '../lib/paths';
import '../styles/tokens.css';

interface Props {
  title: string;
  siteTitle: string;
  description?: string;
  sourceUrl?: string | null;
  chrome?: boolean;
  wide?: boolean;
  noindex?: boolean;
}

const {
  title,
  siteTitle,
  description = '',
  sourceUrl = null,
  chrome = true,
  wide = false,
  noindex = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? title : `${title} · ${siteTitle}`}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap"
    />
    <ThemeInit />
  </head>
  <body>
    <main class={wide ? 'shell shell--wide' : 'shell'}>
      <slot />
    </main>
    {chrome && <Chrome sourceUrl={sourceUrl} title={siteTitle} />}
  </body>
</html>

<style is:global>
  .shell {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 1.5rem 8rem;
  }

  .shell--wide {
    max-width: var(--page);
  }

  /* Prose defaults, scoped so the index page can opt out per element. */
  .shell h1 {
    font-weight: 500;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    text-wrap: balance;
    margin: 0 0 1.5rem;
  }

  .shell h2 {
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.25;
    letter-spacing: -.01em;
    text-wrap: balance;
    margin: 3rem 0 .75rem;
  }

  .shell h3 {
    font-weight: 600;
    font-size: 1.05rem;
    margin: 2.25rem 0 .5rem;
  }

  .shell p {
    margin: 0 0 1.1rem;
  }

  .shell ul,
  .shell ol {
    padding-left: 1.2rem;
  }

  .shell li {
    margin: .35rem 0;
  }

  .shell hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .shell code {
    font-family: var(--mono);
    font-size: .82em;
    background: var(--accent-soft);
    padding: .15em .4em;
    border-radius: 3px;
  }

  .shell pre {
    font-family: var(--mono);
    font-size: .82rem;
    line-height: 1.7;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .shell pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .shell table {
    width: 100%;
    border-collapse: collapse;
    font-size: .95rem;
    margin: 1.5rem 0;
    font-variant-numeric: tabular-nums;
  }

  .shell th {
    font-weight: 600;
    font-size: .72rem;
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted);
  }

  .shell th,
  .shell td {
    text-align: left;
    border-bottom: 1px solid var(--border);
    padding: .6rem .7rem .6rem 0;
    vertical-align: top;
  }

  .shell img {
    max-width: 100%;
    height: auto;
  }

  .shell blockquote {
    margin: 1.75rem 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--border-strong);
    color: var(--muted);
    font-style: italic;
  }
</style>
