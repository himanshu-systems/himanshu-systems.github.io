---
import Chrome from '../components/Chrome.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ScrollInit from '../components/ScrollInit.astro';
import FloatingShape from '../components/FloatingShape.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import { asset } from '../lib/paths';
import '../styles/tokens.css';

interface Props {
  title: string;
  siteTitle: string;
  description?: string;
  sourceUrl?: string | null;
  chrome?: boolean;
  wide?: boolean;
  noindex?: boolean;
  /** Off on /admin -- a toy floating over a data-entry form is a liability, not a delight. */
  floatingShape?: boolean;
  /** Off on /admin -- lerped scroll fights a form's native scrollIntoView() calls. */
  smoothScroll?: boolean;
  /** Off on /admin -- a registration frame around a data-entry form is noise, not atmosphere. */
  instrument?: boolean;
}

const {
  title,
  siteTitle,
  description = '',
  sourceUrl = null,
  chrome = true,
  wide = false,
  noindex = false,
  floatingShape = true,
  smoothScroll = true,
  instrument = true,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? title : `${title} · ${siteTitle}`}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap"
    />
    <ThemeInit />
    {smoothScroll && <ScrollInit />}
  </head>
  <body class={instrument ? 'instrument' : undefined}>
    {smoothScroll ? (
      <div id="smooth-wrapper">
        <div id="smooth-content">
          <main class={wide ? 'shell shell--wide' : 'shell'}>
            <slot />
          </main>
          {chrome && <Chrome sourceUrl={sourceUrl} title={siteTitle} />}
        </div>
      </div>
    ) : (
      <>
        <main class={wide ? 'shell shell--wide' : 'shell'}>
          <slot />
        </main>
        {chrome && <Chrome sourceUrl={sourceUrl} title={siteTitle} />}
      </>
    )}
    {floatingShape && <FloatingShape />}
    {smoothScroll && <SmoothScroll />}
  </body>
</html>

<style is:global>
  /* ── Instrument chrome ──────────────────────────────────────────────
     One ambient layer around the page that never touches content: a
     hairline frame with accent registration ticks at the corners. Drawn
     from --border / --accent, so it re-themes for free and stays at the
     same whisper volume as every other hairline on the site. It's
     pointer-events: none and purely decorative, so it isn't announced to
     a screen reader and can't intercept a click. Off on /admin
     (instrument={false}). */

  /* Registration frame: hairline rectangle, accent ticks at each corner --
     the crop marks on a print proof, or a viewfinder. Above the floating
     shape's z-index: 40 deliberately, so the frame reads as the outermost
     layer of the whole instrument. */
  body.instrument::after {
    content: '';
    position: fixed;
    inset: 1.15rem;
    pointer-events: none;
    z-index: 60;
    border: 1px solid var(--border);
    background-origin: border-box;
    background-repeat: no-repeat;
    background-image:
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent));
    background-size:
      12px 1px, 1px 12px,
      12px 1px, 1px 12px,
      12px 1px, 1px 12px,
      12px 1px, 1px 12px;
    background-position:
      0 0, 0 0,
      100% 0, 100% 0,
      0 100%, 0 100%,
      100% 100%, 100% 100%;
  }

  /* Not in print -- a fixed frame can only ever mark the first sheet. */
  @media print {
    body.instrument::after {
      display: none;
    }
  }

  /* ScrollSmoother's required shape: the wrapper is clipped to the viewport
     and #smooth-content gets transformed inside it, so the "real" scrollbar
     comes from a spacer ScrollSmoother measures off #smooth-content's height.
     Gated on the html.gsap-smooth stamp from ScrollInit -- without it (JS
     disabled, or prefers-reduced-motion), these two divs stay plain blocks
     and the page just scrolls the normal way. Printing gets the same native
     fallback: a fixed, clipped wrapper can only ever print one page's worth. */
  html.gsap-smooth #smooth-wrapper {
    position: fixed;
    inset: 0;
    overflow: hidden;
  }

  html.gsap-smooth #smooth-content {
    overflow: visible;
    width: 100%;
  }

  @media print {
    html.gsap-smooth #smooth-wrapper {
      position: static;
      overflow: visible;
    }
  }

  .shell {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 1.5rem 8rem;
  }

  .shell--wide {
    max-width: var(--page);
  }

  /* Prose defaults, scoped so the index page can opt out per element. */
  .shell h1 {
    font-weight: 500;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -.02em;
    text-wrap: balance;
    margin: 0 0 1.5rem;
  }

  .shell h2 {
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.25;
    letter-spacing: -.01em;
    text-wrap: balance;
    margin: 3rem 0 .75rem;
  }

  .shell h3 {
    font-weight: 600;
    font-size: 1.05rem;
    margin: 2.25rem 0 .5rem;
  }

  .shell p {
    margin: 0 0 1.1rem;
  }

  .shell ul,
  .shell ol {
    padding-left: 1.2rem;
  }

  .shell li {
    margin: .35rem 0;
  }

  .shell hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .shell code {
    font-family: var(--mono);
    font-size: .82em;
    background: var(--accent-soft);
    padding: .15em .4em;
    border-radius: 3px;
  }

  .shell pre {
    font-family: var(--mono);
    font-size: .82rem;
    line-height: 1.7;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .shell pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .shell table {
    width: 100%;
    border-collapse: collapse;
    font-size: .95rem;
    margin: 1.5rem 0;
    font-variant-numeric: tabular-nums;
  }

  .shell th {
    font-weight: 600;
    font-size: .72rem;
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted);
  }

  .shell th,
  .shell td {
    text-align: left;
    border-bottom: 1px solid var(--border);
    padding: .6rem .7rem .6rem 0;
    vertical-align: top;
  }

  .shell img {
    max-width: 100%;
    height: auto;
  }

  .shell blockquote {
    margin: 1.75rem 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--border-strong);
    color: var(--muted);
    font-style: italic;
  }
</style>
