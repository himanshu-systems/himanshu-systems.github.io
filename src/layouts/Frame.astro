---
import ThemeInit from '../components/ThemeInit.astro';
import { collection, asset } from '../lib/paths';
import '../styles/tokens.css';

interface Props {
  title: string;
  siteTitle: string;
  url: string;
}

const { title, siteTitle, url } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {siteTitle}</title>
    <link rel="icon" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Literata:opsz,wght@7..72,400;7..72,500&display=swap"
    />
    <ThemeInit />
  </head>
  <body>
    <div class="bar">
      <a href={collection}>&#8592; Collection</a>
      <strong>{title}</strong>
      <span class="spacer"></span>
      <span class="hint">Blank below? The source blocks embedding &mdash;</span>
      <a href={url} target="_blank" rel="noopener noreferrer">open it directly &#8599;</a>
    </div>
    <iframe src={url} title={title} loading="lazy" referrerpolicy="no-referrer"></iframe>
  </body>
</html>

<style>
  html,
  body {
    height: 100%;
  }
  body {
    display: flex;
    flex-direction: column;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: .55rem 1rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .02em;
  }
  .bar a {
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .bar strong {
    font-family: var(--serif);
    font-size: .95rem;
    letter-spacing: 0;
  }
  .bar a:hover {
    text-decoration: underline;
  }
  .spacer {
    flex: 1;
  }
  .hint {
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    .hint {
      display: none;
    }
  }
  iframe {
    flex: 1;
    width: 100%;
    border: 0;
    background: var(--bg);
  }
</style>
